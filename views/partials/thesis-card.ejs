<div class="col-md-6 mb-4">
    <div class="card h-100<% if (thesis.is_locked) { %> border-danger<% } %>">
        <div class="card-header<% if (thesis.is_locked) { %> bg-warning-subtle<% } %>">
            <h6 class="mb-0">
                <% if (thesis.is_locked) { %><i class="bi bi-slash-circle-fill text-danger me-1" title="<%= t('dashboard.thesisLocked') %>"></i><% } %>
                <i class="bi bi-file-text"></i> <%= thesis.title %>
                <% if (swarm) { %><span class="badge bg-warning text-dark ms-2"><%= t('swarm.dashboard.badge') %></span><% } %>
            </h6>
        </div>
        <div class="card-body">
            <p><strong><%= t('dashboard.department') %>:</strong> <%= thesis.department.name %></p>
            <% if (thesis.sponsor) { %>
                <p><strong><%= t('dashboard.headers.sponsor') %>:</strong> <%= thesis.sponsor %></p>
            <% } %>
            <div class="mt-3">
                <h6><%= t('dashboard.headers.students') %>:</h6>
                <% thesis.students.forEach(function(s) { %>
                    <div class="mb-2">
                        <i class="bi bi-person-fill"></i> <%= s.name %>, <%= s.firstname %>
                        <% if (thesis.is_repetent) { %>
                            <span class="badge bg-warning text-dark ms-1"><i class="bi bi-arrow-repeat"></i> <%= t('dashboard.repetent') %></span>
                        <% } %>
                        <br><small class="text-muted"><%= s.email %></small>
                    </div>
                <% }); %>
            </div>
            <% if (thesis.experts.length > 0) { %>
                <div class="mt-3">
                    <h6><%= t('dashboard.headers.experts') %>:</h6>
                    <% thesis.experts.forEach(function(e) { %>
                        <div class="mb-2">
                            <i class="bi bi-award"></i> <%= e.name %>, <%= e.firstname %>
                            <br><small class="text-muted"><%= e.email %></small>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
        <div class="card-footer">
            <a href="/dashboard/thesis/<%= thesis.id %>" class="btn btn-primary btn-sm">
                <i class="bi bi-eye"></i> <%= t('misc.viewDetails') %>
            </a>
        </div>
    </div>
</div>
