<!-- Rollen-Switcher für User mit mehreren zugewiesenen Rollen. Erwartet:
       - availableRoles: Array der zugewiesenen Rollen (Strings)
       - currentRole:    aktuell aktive Rolle
     Rendert nichts, wenn der User nur eine Rolle hat. -->
<% if ((availableRoles || []).length > 1) {
   const ROLE_LABELS = {
     student: t('roles.student'),
     coach: t('roles.coach'),
     expert: t('roles.expert'),
     admin: t('roles.admin'),
     department_lead: t('roles.department_lead'),
     field_project_coach: t('roles.field_project_coach'),
   };
%>
<div class="d-flex align-items-center gap-2">
    <i class="bi bi-person-badge text-muted"></i>
    <select class="form-select form-select-sm" style="width:auto;" id="roleSwitcher"
            onchange="switchActiveRole(this.value)" aria-label="<%= t('misc.switchRole') %>">
        <% availableRoles.forEach(function(r) { %>
            <option value="<%= r %>" <%= r === currentRole ? 'selected' : '' %>><%= ROLE_LABELS[r] || r %></option>
        <% }); %>
    </select>
</div>
<script>
function switchActiveRole(role) {
    fetch('/api/role/switch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role })
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) location.href = '/dashboard';
        else alert(<%- JSON.stringify(t('templatesPage.errorPrefix')) %> + (d.message || <%- JSON.stringify(t('misc.unknown')) %>));
    })
    .catch(err => { console.error(err); alert(<%- JSON.stringify(t('misc.switchFailed')) %>); });
}
</script>
<% } %>
