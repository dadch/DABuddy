<%# Rückmeldungsliste Projektskizze (Schwarmmodus) auf einem Meilenstein.
    Parameter: m, feedbacks, canRead, canWrite, thesisId, user, fmtDateTime %>
<%# Sichtbar, solange der Meilenstein markiert ist ODER Rückmeldungen existieren
    (nach dem Entfernen der Markierung bleiben sie lesbar, Erfassen nur markiert). %>
<% if (m.swarm_feedback_enabled || (feedbacks && feedbacks.length > 0)) {
    const sfList = feedbacks || [];
    const sfBadge = { continue: 'bg-success', continue_with_conditions: 'bg-warning text-dark', stop: 'bg-danger' };
    const sfRoleLabel = (r) => { const k = 'roles.' + r; const v = t(k); return (v && v !== k) ? v : r; };
    const sfDate = (s) => {
        const mm = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s || ''));
        const d = mm ? new Date(Number(mm[1]), Number(mm[2]) - 1, Number(mm[3])) : new Date(s);
        return isNaN(d) ? String(s) : d.toLocaleDateString(lang === 'fr' ? 'fr-CH' : 'de-CH');
    };
%>
<div class="mt-3 border rounded p-2">
    <div class="d-flex justify-content-between align-items-center">
        <strong class="small"><i class="bi bi-people-fill"></i> <%= t('swarm.feedback.listTitle') %></strong>
        <% if (canWrite && m.swarm_feedback_enabled) { %>
            <a class="btn btn-outline-primary btn-sm" href="/dashboard/thesis/<%= thesisId %>/swarm-feedback/<%= m.id %>">
                <%= sfList.some(f => f.author_user_id === user.id) ? t('swarm.feedback.buttonEdit') : t('swarm.feedback.button') %>
            </a>
        <% } %>
    </div>
    <% if (!canRead) { %>
        <small class="text-muted"><i class="bi bi-hourglass-split"></i> <%= t('swarm.feedback.studentHidden') %></small>
    <% } else if (sfList.length === 0) { %>
        <small class="text-muted"><%= t('swarm.feedback.none') %></small>
    <% } else { %>
        <% sfList.forEach(function (f) { %>
            <div class="border-top py-2 mt-2">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="small">
                        <%= f.author ? (f.author.name + ', ' + f.author.firstname) : t('thesisDetail.unknown') %>
                        &middot; <%= sfRoleLabel(f.author_role) %>
                        &middot; <%= fmtDateTime(f.createdAt) %>
                        <span class="badge <%= sfBadge[f.recommendation] || 'bg-secondary' %> ms-1"><%= t('swarm.feedback.recommendation.' + f.recommendation) %></span>
                    </div>
                    <div class="text-nowrap ms-2">
                        <a class="btn btn-outline-secondary btn-sm" href="/api/swarm-feedbacks/<%= f.id %>/pdf" target="_blank"><i class="bi bi-file-earmark-pdf"></i> <%= t('swarm.feedback.pdf') %></a>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#sf-<%= f.id %>"><i class="bi bi-chevron-down"></i> <%= t('common.details') %></button>
                        <% if (user.role === 'admin') { %>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-confirm-text="<%= t('swarm.feedback.deleteConfirm') %>" data-orig-text="<%= t('swarm.feedback.delete') %>" onclick="swarmFeedbackDelete(this, <%= Number(f.id) %>)"><i class="bi bi-trash"></i> <span><%= t('swarm.feedback.delete') %></span></button>
                        <% } %>
                    </div>
                </div>
                <div class="collapse mt-2" id="sf-<%= f.id %>">
                    <% [1, 2, 3].forEach(function (n) { const txt = f['criterion_' + n]; if (txt) { %>
                        <div class="mb-2">
                            <strong class="small"><%= t('swarm.feedback.criteria.c' + n + '.title') %></strong>
                            <div style="white-space: pre-wrap"><%= txt %></div>
                        </div>
                    <% } }); %>
                    <% if (f.recommendation !== 'continue' && (f.condition_what || f.condition_until)) { %>
                        <% if (f.condition_what) { %>
                            <div class="mb-2">
                                <strong class="small"><%= t('swarm.feedback.conditionWhat') %></strong>
                                <div style="white-space: pre-wrap"><%= f.condition_what %></div>
                            </div>
                        <% } %>
                        <% if (f.condition_until) { %>
                            <div class="mb-2">
                                <strong class="small"><%= t('swarm.feedback.conditionUntil') %></strong>
                                <div><%= sfDate(f.condition_until) %></div>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        <% }); %>
        <% if (user.role === 'admin') { %>
<script>
if (!window.swarmFeedbackDelete) {
    window.swarmFeedbackDelete = function (btn, id) {
        if (!btn.dataset.armed) {
            btn.dataset.armed = '1';
            btn.classList.remove('btn-outline-danger');
            btn.classList.add('btn-danger');
            btn.querySelector('span').textContent = btn.dataset.confirmText;
            return;
        }
        btn.disabled = true;
        fetch('/api/swarm-feedbacks/' + id, { method: 'DELETE' })
            .then(function (r) { return r.json(); })
            .then(function (j) { if (j && j.success) { location.reload(); } else { btn.disabled = false; } })
            .catch(function () { btn.disabled = false; });
    };
}
</script>
        <% } %>
    <% } %>
</div>
<% } %>
