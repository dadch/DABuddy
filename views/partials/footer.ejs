    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.7/dist/purify.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
<script>
    // Markdown-Helfer. Einzelne Zeilenumbrüche und Leerzeilen werden berücksichtigt
    // (breaks + gfm). Die HTML-Ausgabe von marked wird IMMER mit DOMPurify
    // saniert (Schutz vor Stored XSS über Freitext-Felder wie Bewertungs-
    // Kommentare/Labels). Ist DOMPurify nicht geladen, wird auf reinen,
    // escapeten Text zurückgefallen — niemals ungefiltertes marked-HTML.
    var MD_OPTS = { breaks: true, gfm: true };
    function escapeTextFallback(s) {
        return s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    }
    // Gibt sanierten HTML-String zurück oder null, wenn kein Sanitizer verfügbar ist.
    function sanitizeHtml(html) {
        if (window.DOMPurify && typeof DOMPurify.sanitize === 'function') return DOMPurify.sanitize(html);
        return null;
    }
    function renderMarkdownInline(text) {
        const s = (text === undefined || text === null) ? '' : String(text);
        try {
            if (window.marked && typeof marked.parseInline === 'function') {
                const clean = sanitizeHtml(marked.parseInline(s, MD_OPTS));
                if (clean !== null) return clean;
            }
        } catch (e) { /* fall through */ }
        return escapeTextFallback(s);
    }
    function renderMarkdownBlock(text) {
        const s = (text === undefined || text === null) ? '' : String(text);
        try {
            if (window.marked && typeof marked.parse === 'function') {
                const clean = sanitizeHtml(marked.parse(s, MD_OPTS));
                if (clean !== null) return clean;
            }
        } catch (e) { /* fall through */ }
        return escapeTextFallback(s).replace(/\n/g, '<br>');
    }
</script>
<script src="/js/app.js"></script>
</body>
</html>
