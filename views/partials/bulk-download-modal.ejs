<!-- Bulk-Download-Modal: lässt Admin/FBL alle Dokumente einer Upload-Kategorie
     für die aktuell sichtbaren DAs als ZIP herunterladen. Erwartet:
       - selectedDepartment: optionaler Department-Filter aus dem Dashboard. -->
<div class="modal fade" id="bulkDownloadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-archive"></i> <%= t('bulkDownload.title') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="bulkDownloadForm">
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        <%= t('bulkDownload.description') %>
                    </p>
                    <div class="mb-3">
                        <label class="form-label"><%= t('bulkDownload.documentType') %></label>
                        <select class="form-select" id="bulkDownloadCategory" required>
                            <option value=""><%= t('common.loading') %></option>
                        </select>
                        <div class="form-text">
                            <%- t('bulkDownload.feedbackHint') %>
                        </div>
                    </div>
                    <div id="bulkDownloadError" class="alert alert-danger mb-0 d-none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-download"></i> <%= t('bulkDownload.downloadZip') %></button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
(function() {
    const SELECTED_DEPARTMENT = <%- JSON.stringify(typeof selectedDepartment !== 'undefined' && selectedDepartment ? String(selectedDepartment) : '') %>;
    const L = {
        selectPlaceholder: <%- JSON.stringify(t('bulkDownload.selectPlaceholder')) %>,
        uploadCategories: <%- JSON.stringify(t('dashboard.actions.uploadCategories')) %>,
        otherGroup: <%- JSON.stringify(t('bulkDownload.otherGroup')) %>,
        feedbackFormPdf: <%- JSON.stringify(t('bulkDownload.feedbackFormPdf')) %>,
        loadCategoriesError: <%- JSON.stringify(t('bulkDownload.loadCategoriesError')) %>,
    };
    let categoriesLoaded = false;
    // Feedbackformular ist keine echte Upload-Kategorie, wird aber im gleichen
    // Auswahl-Dropdown angeboten — mit reserviertem Wert 'feedback'.
    const FEEDBACK_VALUE = 'feedback';
    function loadCategoriesOnce() {
        if (categoriesLoaded) return Promise.resolve();
        return fetch('/api/upload-categories?onlyActive=1')
            .then(r => r.json())
            .then(cats => {
                const sel = document.getElementById('bulkDownloadCategory');
                const options = [`<option value="">${L.selectPlaceholder}</option>`];
                if (Array.isArray(cats) && cats.length > 0) {
                    options.push(`<optgroup label="${L.uploadCategories}">`);
                    for (const c of cats) {
                        options.push(`<option value="${c.id}">${c.label.replace(/[<>&"']/g, '')}</option>`);
                    }
                    options.push('</optgroup>');
                }
                options.push(`<optgroup label="${L.otherGroup}">`);
                options.push(`<option value="${FEEDBACK_VALUE}">${L.feedbackFormPdf}</option>`);
                options.push('</optgroup>');
                sel.innerHTML = options.join('');
                categoriesLoaded = true;
            });
    }
    window.openBulkDownloadModal = function() {
        document.getElementById('bulkDownloadError').classList.add('d-none');
        loadCategoriesOnce().catch(() => {
            const e = document.getElementById('bulkDownloadError');
            e.textContent = L.loadCategoriesError;
            e.classList.remove('d-none');
        });
        new bootstrap.Modal(document.getElementById('bulkDownloadModal')).show();
    };
    document.getElementById('bulkDownloadForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const cid = document.getElementById('bulkDownloadCategory').value;
        if (!cid) return;
        const params = new URLSearchParams();
        if (SELECTED_DEPARTMENT) params.set('department', SELECTED_DEPARTMENT);
        const qs = params.toString() ? '?' + params.toString() : '';
        const url = cid === FEEDBACK_VALUE
            ? `/api/feedback-forms/bulk-download.zip${qs}`
            : `/api/upload-categories/${cid}/bulk-download.zip${qs}`;
        // Über verstecktes iframe streamen, damit die aktuelle Seite stehen bleibt.
        let frame = document.getElementById('bulkDownloadFrame');
        if (!frame) {
            frame = document.createElement('iframe');
            frame.id = 'bulkDownloadFrame';
            frame.style.display = 'none';
            document.body.appendChild(frame);
        }
        frame.src = url;
        bootstrap.Modal.getInstance(document.getElementById('bulkDownloadModal')).hide();
    });
})();
</script>
