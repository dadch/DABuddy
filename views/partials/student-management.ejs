<!-- Studierenden-Verwaltung (Admin + FachbereichsleiterIn). Erwartet `departments` im Render-Kontext. -->
<div class="modal fade" id="studentManagementModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('studentMgmt.title') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 mb-3">
                    <button type="button" class="btn btn-success" onclick="openAddStudent()">
                        <i class="bi bi-person-plus"></i> <%= t('studentMgmt.addStudent') %>
                    </button>
                    <button type="button" class="btn btn-outline-primary" onclick="openImportStudents()">
                        <i class="bi bi-upload"></i> <%= t('studentMgmt.csvImport') %>
                    </button>
                </div>
                <div id="studentsList"><p class="text-muted"><%= t('common.loading') %></p></div>
            </div>
        </div>
    </div>
</div>

<!-- Hinzufügen / Bearbeiten -->
<div class="modal fade" id="studentFormModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="studentFormTitle"><%= t('studentMgmt.addStudent') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="studentForm">
                <div class="modal-body">
                    <input type="hidden" id="studentId">
                    <div class="mb-3">
                        <label class="form-label"><%= t('studentMgmt.name') %></label>
                        <input type="text" class="form-control" id="studentName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('studentMgmt.firstname') %></label>
                        <input type="text" class="form-control" id="studentFirstname" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('studentMgmt.email') %></label>
                        <input type="email" class="form-control" id="studentEmail" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('studentMgmt.phone') %></label>
                        <input type="tel" class="form-control" id="studentPhone">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('studentMgmt.gender') %></label>
                        <select class="form-select" id="studentGender" required>
                            <option value=""><%= t('studentMgmt.selectPlaceholder') %></option>
                            <option value="m"><%= t('studentMgmt.genderMale') %> (m)</option>
                            <option value="w"><%= t('studentMgmt.genderFemale') %> (w)</option>
                            <option value="d"><%= t('studentMgmt.genderDiverse') %> (d)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('dashboard.department') %></label>
                        <select class="form-select" id="studentDepartment" required>
                            <option value=""><%= t('studentMgmt.selectPlaceholder') %></option>
                            <% (departments || []).forEach(function(dept) { %>
                                <option value="<%= dept.id %>"><%= dept.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-text" id="studentFormHint"><%- t('studentMgmt.loginHint') %></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                    <button type="submit" class="btn btn-primary"><%= t('common.save') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CSV-Import -->
<div class="modal fade" id="importStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('studentMgmt.importTitle') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="importStudentForm">
                <div class="modal-body">
                    <p class="small mb-1"><%- t('studentMgmt.importInstructions1') %></p>
                    <p class="small"><%- t('studentMgmt.importColumns') %></p>
                    <p class="small text-muted"><%= t('studentMgmt.validDepartments') %> <%= (departments || []).map(function(d){ return d.name; }).join(', ') %></p>
                    <p class="small text-muted"><%- t('studentMgmt.importLoginHint') %></p>
                    <textarea class="form-control" id="importCsv" rows="10" placeholder="<%= t('studentMgmt.importPlaceholder') %>"></textarea>
                    <div id="importResult" class="mt-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.close') %></button>
                    <button type="submit" class="btn btn-primary"><%= t('studentMgmt.import') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const L = {
    name: <%- JSON.stringify(t('studentMgmt.name')) %>,
    firstname: <%- JSON.stringify(t('studentMgmt.firstname')) %>,
    email: <%- JSON.stringify(t('studentMgmt.email')) %>,
    gender: <%- JSON.stringify(t('studentMgmt.gender')) %>,
    department: <%- JSON.stringify(t('dashboard.department')) %>,
    actions: <%- JSON.stringify(t('common.actions')) %>,
    genderMale: <%- JSON.stringify(t('studentMgmt.genderMale')) %>,
    genderFemale: <%- JSON.stringify(t('studentMgmt.genderFemale')) %>,
    genderDiverse: <%- JSON.stringify(t('studentMgmt.genderDiverse')) %>,
    addStudent: <%- JSON.stringify(t('studentMgmt.addStudent')) %>,
    editStudent: <%- JSON.stringify(t('studentMgmt.editStudent')) %>,
    noStudents: <%- JSON.stringify(t('studentMgmt.noStudents')) %>,
    loadError: <%- JSON.stringify(t('studentMgmt.loadError')) %>,
    username: <%- JSON.stringify(t('studentMgmt.username')) %>,
    deleteConfirm: <%- JSON.stringify(t('studentMgmt.deleteConfirm')) %>,
    saveError: <%- JSON.stringify(t('studentMgmt.saveError')) %>,
    deleteError: <%- JSON.stringify(t('studentMgmt.deleteError')) %>,
    importedCount: <%- JSON.stringify(t('studentMgmt.importedCount')) %>,
    linesSkipped: <%- JSON.stringify(t('studentMgmt.linesSkipped')) %>,
    lineError: <%- JSON.stringify(t('studentMgmt.lineError')) %>,
    importError: <%- JSON.stringify(t('studentMgmt.importError')) %>,
    errorPrefix: <%- JSON.stringify(t('templatesPage.errorPrefix')) %>,
    genericError: <%- JSON.stringify(t('templatesPage.genericError')) %>,
    unknown: <%- JSON.stringify(t('misc.unknown')) %>,
};
const GENDER_LABELS = { m: L.genderMale, w: L.genderFemale, d: L.genderDiverse };
function stuEscape(s){ return (s||'').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

function openStudentManagement() {
    loadStudentList();
    new bootstrap.Modal(document.getElementById('studentManagementModal')).show();
}

function loadStudentList() {
    fetch('/api/students')
        .then(r => r.json())
        .then(students => {
            const el = document.getElementById('studentsList');
            if (!students.length) { el.innerHTML = `<p class="text-muted mb-0">${stuEscape(L.noStudents)}</p>`; return; }
            el.innerHTML = `
                <div class="table-responsive"><table class="table table-striped">
                    <thead><tr><th>${stuEscape(L.name)}</th><th>${stuEscape(L.firstname)}</th><th>${stuEscape(L.email)}</th><th>${stuEscape(L.gender)}</th><th>${stuEscape(L.department)}</th><th>${stuEscape(L.username)}</th><th>${stuEscape(L.actions)}</th></tr></thead>
                    <tbody>
                        ${students.map(s => `
                            <tr>
                                <td>${stuEscape(s.name)}</td>
                                <td>${stuEscape(s.firstname)}</td>
                                <td>${stuEscape(s.email)}</td>
                                <td>${GENDER_LABELS[s.gender] || '–'}</td>
                                <td>${(s.departments||[]).map(d => `<span class="badge bg-info me-1">${stuEscape(d.name)}</span>`).join('') || '<span class="text-muted">–</span>'}</td>
                                <td><small class="text-muted">${stuEscape(s.username)}</small></td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm" onclick='editStudentOpen(${JSON.stringify(s).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" onclick="deleteStudentRow(${s.id}, '${stuEscape(s.name + ', ' + s.firstname).replace(/'/g, "\\'")}')"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>`).join('')}
                    </tbody>
                </table></div>`;
        })
        .catch(e => { console.error(e); document.getElementById('studentsList').innerHTML = `<div class="alert alert-danger">${stuEscape(L.loadError)}</div>`; });
}

function openAddStudent() {
    document.getElementById('studentForm').reset();
    document.getElementById('studentId').value = '';
    document.getElementById('studentFormTitle').textContent = L.addStudent;
    document.getElementById('studentFormHint').classList.remove('d-none');
    new bootstrap.Modal(document.getElementById('studentFormModal')).show();
}

function editStudentOpen(s) {
    document.getElementById('studentForm').reset();
    document.getElementById('studentId').value = s.id;
    document.getElementById('studentFormTitle').textContent = L.editStudent;
    document.getElementById('studentName').value = s.name || '';
    document.getElementById('studentFirstname').value = s.firstname || '';
    document.getElementById('studentEmail').value = s.email || '';
    document.getElementById('studentPhone').value = s.phone || '';
    document.getElementById('studentGender').value = s.gender || '';
    document.getElementById('studentDepartment').value = (s.departments && s.departments[0]) ? s.departments[0].id : '';
    document.getElementById('studentFormHint').classList.add('d-none');
    new bootstrap.Modal(document.getElementById('studentFormModal')).show();
}

document.getElementById('studentForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const id = document.getElementById('studentId').value;
    const data = {
        name: document.getElementById('studentName').value,
        firstname: document.getElementById('studentFirstname').value,
        email: document.getElementById('studentEmail').value,
        phone: document.getElementById('studentPhone').value,
        gender: document.getElementById('studentGender').value,
        department: document.getElementById('studentDepartment').value,
    };
    const url = id ? '/api/students/' + id : '/api/students';
    fetch(url, { method: id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                bootstrap.Modal.getInstance(document.getElementById('studentFormModal')).hide();
                loadStudentList();
            } else alert(L.errorPrefix + (d.message || L.unknown));
        })
        .catch(e => { console.error(e); alert(L.saveError); });
});

function deleteStudentRow(id, label) {
    if (!confirm(L.deleteConfirm.replace('{{name}}', label))) return;
    fetch('/api/students/' + id, { method: 'DELETE' })
        .then(r => r.json())
        .then(d => { if (d.success) loadStudentList(); else alert(L.errorPrefix + (d.message || L.unknown)); })
        .catch(e => { console.error(e); alert(L.deleteError); });
}

function openImportStudents() {
    document.getElementById('importStudentForm').reset();
    document.getElementById('importResult').innerHTML = '';
    new bootstrap.Modal(document.getElementById('importStudentModal')).show();
}

document.getElementById('importStudentForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const csv = document.getElementById('importCsv').value;
    const btn = this.querySelector('button[type="submit"]');
    btn.disabled = true;
    fetch('/api/students/import', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ csv }) })
        .then(r => r.json())
        .then(d => {
            btn.disabled = false;
            if (!d.success) { document.getElementById('importResult').innerHTML = '<div class="alert alert-danger">' + (d.message || L.genericError) + '</div>'; return; }
            let html = `<div class="alert alert-success">${L.importedCount.replace('{{n}}', d.created)}</div>`;
            if (d.errors && d.errors.length) {
                html += '<div class="alert alert-warning"><strong>' + L.linesSkipped.replace('{{n}}', d.errors.length) + '</strong><ul class="mb-0">' +
                    d.errors.map(er => `<li>${stuEscape(L.lineError.replace('{{n}}', er.line))} ${stuEscape(er.message)}</li>`).join('') + '</ul></div>';
            }
            document.getElementById('importResult').innerHTML = html;
            loadStudentList();
        })
        .catch(e => { btn.disabled = false; console.error(e); alert(L.importError); });
});
</script>
