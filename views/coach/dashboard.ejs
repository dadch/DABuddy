<%- include('../partials/header', { title: t('misc.coachDashboardTitle') + ' - ThesisBuddy', user: user }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= t('dashboard.titleCoach') %></h1>
    <div class="d-flex align-items-center gap-3">
        <span class="text-muted"><i class="bi bi-calendar"></i> <%= t('dashboard.year') %>: <%= yearLabel(selectedYearObj) %></span>
        <%- include('../partials/role-switcher', { availableRoles: availableRoles, currentRole: currentRole }) %>
    </div>
</div>

<% if (theses.length === 0 && swarmTheses.length === 0) { %>
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i>
        <%= t('dashboard.noTheses_role') %>
    </div>
<% } else if (theses.length > 0) { %>
    <div class="row">
        <% theses.forEach(function(thesis) { %>
            <%- include('../partials/thesis-card', { thesis: thesis, swarm: false }) %>
        <% }); %>
    </div>
<% } %>

<% if (swarmTheses.length > 0) { %>
    <h2 class="h4 mt-4"><i class="bi bi-people-fill"></i> <%= t('swarm.dashboard.sectionTitle') %></h2>
    <div class="row">
        <% swarmTheses.forEach(function(thesis) { %>
            <%- include('../partials/thesis-card', { thesis: thesis, swarm: true }) %>
        <% }); %>
    </div>
<% } %>

<%- include('../partials/footer') %>
