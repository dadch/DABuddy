<%- include('../partials/header', { title: 'Diplomarbeit-Details - ThesisBuddy', user: user }) %>

<%
const ROLE_LABELS = { student: t('roles.student'), coach: t('roles.coach'), expert: t('roles.expert'), admin: t('roles.admin'), department_lead: t('roles.department_lead'), field_project_coach: t('roles.field_project_coach') };
const ACTION_LABELS = { document_upload: t('thesisDetail.actionLabels.documentUpload'), document_update: t('thesisDetail.actionLabels.documentUpdate'), document_delete: t('thesisDetail.actionLabels.documentDelete'), evaluation_create: t('thesisDetail.actionLabels.evaluationCreate'), evaluation_update: t('thesisDetail.actionLabels.evaluationUpdate'), milestone_approved: t('thesisDetail.actionLabels.milestoneApproved'), milestone_revoked: t('thesisDetail.actionLabels.milestoneRevoked'), milestone_released: t('thesisDetail.actionLabels.milestoneReleased'), milestone_locked: t('thesisDetail.actionLabels.milestoneLocked'), confidentiality_uploaded: t('thesisDetail.actionLabels.confidentialityUploaded'), confidentiality_deleted: t('thesisDetail.actionLabels.confidentialityDeleted'), thesis_locked: t('thesisDetail.actionLabels.thesisLocked'), thesis_unlocked: t('thesisDetail.actionLabels.thesisUnlocked'), feedback_updated: t('thesisDetail.actionLabels.feedbackUpdated'), reminder_sent: t('thesisDetail.actionLabels.reminderSent'), notification_sent: t('thesisDetail.actionLabels.notificationSent'), assignment_updated: t('thesisDetail.actionLabels.assignmentUpdated'), swarm_feedback_created: t('thesisDetail.actionLabels.swarmFeedbackCreated'), swarm_feedback_updated: t('thesisDetail.actionLabels.swarmFeedbackUpdated'), swarm_feedback_deleted: t('thesisDetail.actionLabels.swarmFeedbackDeleted') };
const isAdmin = user.role === 'admin';
// Stellvertretung: FBL handelt wie Dozent (siehe src/utils/roles.js)
const actsAs = (r) => !!r && (user.role === r || (user.role === 'department_lead' && r === 'coach'));
const fmtDateTime = (d) => new Date(d).toLocaleDateString('de-CH') + ' ' + new Date(d).toLocaleTimeString('de-CH', { hour: '2-digit', minute: '2-digit' });
%>

<% const hasTransferProject = (milestones || []).some(m => m.is_transfer_project); %>
<% const isThesisDeptLead = user.role === 'department_lead' && thesis.department && thesis.department.department_lead_id === user.id; %>
<% const canEditDueAt = isAdmin || isThesisDeptLead; %>
<%
// Studierenden-Sicht: Ist der letzte Meilenstein (spätester Termin, inkl.
// individueller Übersteuerung) abgelaufen, sind Bewertungen und Feedback für
// Studierende auf keinem Meilenstein mehr einsehbar.
const isStudentView = user.role === 'student';
const _nowTs = (typeof nowTs === 'number') ? nowTs : Date.now();
const lastDueTs = (milestones || []).reduce((mx, mm) => Math.max(mx, new Date(mm.due_at).getTime()), 0);
const studentEvalsHidden = isStudentView && lastDueTs > 0 && lastDueTs < _nowTs;
// Aufgabenstellung: Termin "Meilenstein 1" gemäss Diplomjahr und Studienform des
// Fachbereichs. Ab diesem Zeitpunkt steht das PDF Studierenden zum Download
// bereit — unabhängig vom Zustand des Aufgabenstellungs-Meilensteins.
const _studyMode = (thesis.department && thesis.department.study_mode === 'fulltime') ? 'fulltime' : 'parttime';
const assignmentM1 = thesis.year ? thesis.year['assignment_m1_' + _studyMode] : null;
const assignmentAvailableForStudent = !!assignmentM1 && new Date(assignmentM1).getTime() <= _nowTs;
%>
<%- include('../partials/thesis-page-header', { thesis: thesis, user: user, hasTransferProject: hasTransferProject }) %>

<div class="row">
    <div class="col-lg-12">
        <%- include('../partials/thesis-info-card', { thesis: thesis, user: user }) %>
        <%- include('../partials/confidentiality-section', { thesis: thesis, user: user }) %>
        <%- include('../partials/thesis-lock-section', { thesis: thesis, user: user }) %>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-flag"></i> <%= t('thesis.milestones') %></h5>
            </div>
            <div class="card-body">
                <% if (milestones.length === 0) { %>
                    <div class="text-center py-4">
                        <i class="bi bi-flag text-muted" style="font-size: 48px;"></i>
                        <p class="text-muted mt-2"><%= t('thesis.noMilestones') %></p>
                    </div>
                <% } else { %>
                    <% milestones.forEach(function(m) { %>
                        <%
                        const docs = (m.documents || []).slice().sort((a, b) => b.version - a.version);
                        const hasDocs = docs.length > 0;
                        const currentDoc = docs.find(d => d.is_current) || (hasDocs ? docs[0] : null);
                        const isResponsible = actsAs(m.responsible_role) || isAdmin;
                        const isCoachOfThesis = (thesis.coaches || []).some(c => c.id === user.id);
                        const canRelease = isAdmin || (user.role === 'coach' && isCoachOfThesis) || isThesisDeptLead;
                        const cats = (m.uploadCategories || []).slice().sort((a, b) => (a.label||'').localeCompare(b.label||''));
                        const hasCats = cats.length > 0;
                        // Studierenden-Sicht: gesperrt + nicht abgelaufen → Minimalkarte (nur
                        // Name + Termin); abgelaufen → vollständig, aber schreibgeschützt.
                        const msExpired = new Date(m.due_at).getTime() < _nowTs;
                        const minimalCard = isStudentView && !m.released && !msExpired;
                        const studentReadOnly = isStudentView && msExpired;
                        const showUpload = !hasCats && m.allow_upload && isResponsible && (!hasDocs || m.allow_update) && (m.released || isAdmin) && !studentReadOnly;
                        const canEvaluate = m.requires_evaluation && (actsAs(m.evaluator_role) || isAdmin) && !studentReadOnly;
                        const evalByKind = {};
                        (m.thesisEvaluations || []).forEach(e => { evalByKind[e.kind] = e; });
                        const finalExists = !!evalByKind['final'];
                        const isEvaluator1 = (actsAs(m.evaluator_role) && !studentReadOnly) || isAdmin;
                        const isEvaluator2 = (actsAs(m.evaluator_role_2) && !studentReadOnly) || isAdmin;
                        const canFeedback = m.feedback_form_enabled && (isAdmin || user.role === 'department_lead' || user.role === m.evaluator_role || (m.double_evaluation && user.role === m.evaluator_role_2));
                        const feedbackFinal = m.double_evaluation ? evalByKind['final'] : evalByKind['single'];
                        const approvalSlots = [];
                        if (m.requires_approval) approvalSlots.push({ n: 1, role: m.approver_role, approvedAt: m.approved_at, approver: m.approver });
                        if (m.requires_approval_2) approvalSlots.push({ n: 2, role: m.approver_role_2, approvedAt: m.approved_at_2, approver: m.approver2 });
                        const allApproved = approvalSlots.length > 0 && approvalSlots.every(s => s.approvedAt);
                        // Voraussetzungen für eine Freigabe (gespiegelt zu missingApprovalPrerequisites im Backend):
                        // alle erforderlichen Bewertungen vorhanden + Feedbackformular ausgefüllt (falls aktiv).
                        const approvalMissing = [];
                        const _hasGrade = (k) => { const e = evalByKind[k]; return !!(e && e.overall_grade !== null && e.overall_grade !== undefined); };
                        if (m.requires_evaluation) {
                            if (m.double_evaluation) {
                                if (!_hasGrade('first'))  approvalMissing.push(t('thesisDetail.missing.eval1'));
                                if (!_hasGrade('second')) approvalMissing.push(t('thesisDetail.missing.eval2'));
                                if (!_hasGrade('final'))  approvalMissing.push(t('thesisDetail.missing.evalFinal'));
                            } else if (!_hasGrade('single')) {
                                approvalMissing.push(t('thesisDetail.missing.eval'));
                            }
                        }
                        if (m.feedback_form_enabled) {
                            const _fb = m.feedback_text == null ? '' : String(m.feedback_text).trim();
                            if (_fb.length === 0) approvalMissing.push(t('thesisDetail.missing.feedback'));
                        }
                        const canGrantApprovals = approvalMissing.length === 0;
                        const overdue = !hasDocs && new Date(m.due_at) < new Date();
                        %>
                        <div class="milestone-card mb-3">
                            <% if (minimalCard) { %>
                                <%# Gesperrt + nicht abgelaufen: nur Name und Fälligkeitsdatum. %>
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1"><%= milestoneLabel(m) %></h6>
                                        <div class="small text-muted">
                                            <i class="bi bi-calendar-event"></i> <%= fmtDateTime(m.due_at) %>
                                        </div>
                                    </div>
                                    <% if (m.is_assignment && assignmentAvailableForStudent) { %>
                                        <%# Aufgabenstellung ist ab M1-Termin verfügbar — unabhängig vom Meilenstein-Zustand. %>
                                        <a class="btn btn-outline-danger btn-sm" href="/api/thesis-milestones/<%= m.id %>/assignment.pdf" target="_blank">
                                            <i class="bi bi-file-earmark-pdf"></i> <%= t('thesisDetail.assignment') %>
                                        </a>
                                    <% } %>
                                </div>
                            <% } else { %>
                            <div class="d-flex justify-content-between align-items-start flex-wrap">
                                <div>
                                    <h6 class="mb-1"><%= milestoneLabel(m) %></h6>
                                    <div class="small">
                                        <span class="<%= overdue ? 'text-danger fw-bold' : 'text-muted' %>">
                                            <i class="bi bi-calendar-event"></i> <%= fmtDateTime(m.due_at) %>
                                            <% if (overdue) { %> <%= t('thesis.overdue') %><% } %>
                                        </span>
                                        <% if (m.due_at_overridden) { %>
                                            <span class="badge bg-info" title="<%= t('thesisDetail.individualDueDateTitle') %>">
                                                <i class="bi bi-clock-history"></i> <%= t('thesis.individualDueDate') %>
                                            </span>
                                        <% } %>
                                        <% if (canEditDueAt) { %>
                                            <button class="btn btn-sm btn-link p-0 ms-1" data-milestone="<%= JSON.stringify({ id: m.id, label: milestoneLabel(m), due_at: m.due_at }) %>" onclick="openOverrideDueAt(JSON.parse(this.dataset.milestone))" title="<%= t('thesisDetail.overrideDueAtTitle') %>">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <% if (m.due_at_overridden) { %>
                                                <button class="btn btn-sm btn-link p-0 ms-1" onclick="resetDueAt(<%= m.id %>, '<%= milestoneLabel(m).replace(/'/g, "\\'") %>')" title="<%= t('thesisDetail.resetDueAtTitle') %>">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            <% } %>
                                        <% } %>
                                        <span class="badge bg-secondary ms-2"><%= t('thesis.responsibleRole') %>: <%= ROLE_LABELS[m.responsible_role] || m.responsible_role %></span>
                                        <% if (m.released) { %>
                                            <span class="badge bg-success"><i class="bi bi-unlock"></i> <%= t('thesis.released') %></span>
                                        <% } else { %>
                                            <span class="badge bg-secondary"><i class="bi bi-lock"></i> <%= t('thesis.locked') %></span>
                                        <% } %>
                                        <% if (m.requires_evaluation) { %>
                                            <span class="badge bg-warning text-dark"><%= t('thesis.evaluation') %>: <%= ROLE_LABELS[m.evaluator_role] || m.evaluator_role %></span>
                                        <% } %>
                                        <% if (m.is_transfer_project) { %>
                                            <span class="badge bg-info"><i class="bi bi-arrow-left-right"></i> <%= t('thesis.transferProject') %></span>
                                        <% } %>
                                        <% if (m.is_assignment) { %>
                                            <span class="badge bg-dark"><i class="bi bi-file-earmark-text"></i> <%= t('thesisDetail.assignment') %></span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <% if (m.is_assignment) { %>
                                        <% if (actsAs(m.responsible_role) || isAdmin) { %>
                                            <button class="btn btn-outline-dark btn-sm" data-milestone="<%= JSON.stringify({ id: m.id, label: milestoneLabel(m) }) %>" onclick="openAssignmentModal(JSON.parse(this.dataset.milestone))">
                                                <i class="bi bi-file-earmark-text"></i> <%= t('thesisDetail.editAssignment') %>
                                            </button>
                                            <a class="btn btn-outline-danger btn-sm" href="/api/thesis-milestones/<%= m.id %>/assignment.pdf" target="_blank" title="<%= t('thesisDetail.assignmentPdfGenerateTitle') %>">
                                                <i class="bi bi-file-earmark-pdf"></i> <%= t('thesisDetail.assignment') %>
                                            </a>
                                        <% } else if (!isStudentView || assignmentAvailableForStudent) { %>
                                            <a class="btn btn-outline-danger btn-sm" href="/api/thesis-milestones/<%= m.id %>/assignment.pdf" target="_blank" title="<%= t('thesisDetail.assignmentPdfTitle') %>">
                                                <i class="bi bi-file-earmark-pdf"></i> <%= t('thesisDetail.assignment') %>
                                            </a>
                                        <% } %>
                                    <% } %>
                                    <% if (canRelease) { %>
                                        <% if (!m.released) { %>
                                            <button class="btn btn-success btn-sm" onclick="setMilestoneReleased(<%= m.id %>, true)"><i class="bi bi-unlock"></i> <%= t('thesis.grant') %></button>
                                        <% } else { %>
                                            <button class="btn btn-outline-secondary btn-sm" onclick="setMilestoneReleased(<%= m.id %>, false)"><i class="bi bi-lock"></i> <%= t('thesisDetail.lockMilestone') %></button>
                                        <% } %>
                                    <% } %>
                                    <% if (showUpload) { %>
                                        <button class="btn btn-outline-primary btn-sm" onclick="openUploadModal(<%= m.id %>, '<%= milestoneLabel(m).replace(/'/g, "\\'") %>')">
                                            <i class="bi bi-upload"></i> <%= hasDocs ? t('thesisDetail.update') : t('common.upload') %>
                                        </button>
                                    <% } else if (!m.released) { %>
                                        <span class="text-muted small"><%= t('thesisDetail.notYetReleased') %></span>
                                    <% } else if (!m.allow_upload) { %>
                                        <span class="text-muted small"><%= t('thesisDetail.noUploadPlanned') %></span>
                                    <% } else if (!hasDocs) { %>
                                        <span class="text-muted small"><%= t('thesisDetail.waitingFor') %> <%= ROLE_LABELS[m.responsible_role] || m.responsible_role %></span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Dokumente -->
                            <%
                            // Hilfsfunktion: Render eines Dokumenten-Eintrags.
                            function renderDocRow(doc) { %>
                                <div class="d-flex justify-content-between align-items-center border-top py-2">
                                    <div>
                                        <a href="/api/thesis-milestone-documents/<%= doc.id %>/download" class="text-decoration-none">
                                            <i class="bi bi-file-earmark-pdf text-danger"></i> <%= doc.file_name %>
                                        </a>
                                        <% if (doc.is_current) { %>
                                            <span class="badge bg-success ms-1"><%= t('thesisDetail.current') %> · v<%= doc.version %></span>
                                        <% } else { %>
                                            <span class="badge bg-secondary ms-1"><%= t('thesisDetail.previousVersion') %> · v<%= doc.version %></span>
                                        <% } %>
                                        <br>
                                        <small class="text-muted">
                                            <%= formatFileSize(doc.file_size) %> · <%= t('thesisDetail.uploadedBy') %>
                                            <%= doc.uploader ? (doc.uploader.name + ', ' + doc.uploader.firstname) : t('thesisDetail.unknown') %>
                                            <%= t('thesisDetail.on') %> <%= fmtDateTime(doc.uploaded_at) %>
                                            <% if (!doc.is_current && doc.superseded_at) { %>
                                                · <%= t('thesisDetail.supersededOn') %> <%= fmtDateTime(doc.superseded_at) %>
                                            <% } %>
                                        </small>
                                    </div>
                                    <% if (isAdmin) { %>
                                        <button class="btn btn-outline-danger btn-sm" onclick="deleteDocument(<%= doc.id %>)" title="<%= t('thesisDetail.deleteDocVersionTitle') %>">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    <% } %>
                                </div>
                            <% } %>

                            <% if (!hasCats) { /* Legacy: ein Slot ohne Kategorie */ %>
                                <% if (hasDocs) { %>
                                    <div class="mt-3">
                                        <% docs.forEach(function(doc) { renderDocRow(doc); }); %>
                                    </div>
                                <% } else { %>
                                    <div class="mt-2"><small class="text-muted"><i class="bi bi-dash-circle"></i> <%= t('thesisDetail.noDocumentYet') %></small></div>
                                <% } %>
                            <% } else { /* Pro Upload-Kategorie ein eigener Slot */ %>
                                <div class="mt-3">
                                    <% cats.forEach(function(cat) {
                                        const catDocs = docs.filter(d => d.upload_category_id === cat.id);
                                        const catHasDocs = catDocs.length > 0;
                                        const catShowUpload = m.allow_upload && isResponsible && (!catHasDocs || m.allow_update) && (m.released || isAdmin) && !studentReadOnly;
                                    %>
                                        <div class="rounded border mb-2 p-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong><i class="bi bi-tag"></i> <%= categoryLabel(cat) %></strong>
                                                </div>
                                                <div>
                                                    <% if (catShowUpload) { %>
                                                        <button class="btn btn-outline-primary btn-sm"
                                                                onclick="openUploadModal(<%= m.id %>, '<%= milestoneLabel(m).replace(/'/g, "\\'") %>', <%= cat.id %>, '<%= categoryLabel(cat).replace(/'/g, "\\'") %>')">
                                                            <i class="bi bi-upload"></i> <%= catHasDocs ? t('thesisDetail.update') : t('common.upload') %>
                                                        </button>
                                                    <% } else if (!m.released) { %>
                                                        <span class="text-muted small"><%= t('thesisDetail.notYetReleased') %></span>
                                                    <% } else if (!m.allow_upload) { %>
                                                        <span class="text-muted small"><%= t('thesisDetail.noUpload') %></span>
                                                    <% } else if (!catHasDocs) { %>
                                                        <span class="text-muted small"><%= t('thesisDetail.waitingFor') %> <%= ROLE_LABELS[m.responsible_role] || m.responsible_role %></span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <% if (catHasDocs) { catDocs.forEach(function(doc) { renderDocRow(doc); }); } else { %>
                                                <small class="text-muted d-block mt-1"><i class="bi bi-dash-circle"></i> <%= t('thesisDetail.noDocumentYet') %></small>
                                            <% } %>
                                        </div>
                                    <% }); %>
                                    <%
                                    const orphans = docs.filter(d => !cats.find(c => c.id === d.upload_category_id));
                                    if (orphans.length > 0) { %>
                                        <div class="rounded border mb-2 p-2">
                                            <strong class="small text-muted"><i class="bi bi-archive"></i> <%= t('thesisDetail.otherDocuments') %></strong>
                                            <% orphans.forEach(function(doc) { renderDocRow(doc); }); %>
                                        </div>
                                    <% } %>
                                </div>
                            <% } %>

                            <!-- Bewertung -->
                            <% if (m.requires_evaluation && m.double_evaluation && !studentEvalsHidden) { %>
                                <%
                                const phases = [
                                    { kind: 'first', title: t('thesisDetail.evaluation1'), role: m.evaluator_role, owner: isEvaluator1, ev: evalByKind['first'], canView: isAdmin || isEvaluator1 || finalExists },
                                    { kind: 'second', title: t('thesisDetail.evaluation2'), role: m.evaluator_role_2, owner: isEvaluator2, ev: evalByKind['second'], canView: isAdmin || isEvaluator2 || finalExists },
                                    { kind: 'final', title: t('thesisDetail.finalEvaluation'), role: null, owner: (isEvaluator1 || isEvaluator2), ev: evalByKind['final'], canView: true },
                                ];
                                %>
                                <div class="mt-3 bg-light rounded p-2">
                                    <strong class="small"><i class="bi bi-people"></i> <%= t('thesisDetail.doubleEvaluation') %></strong>
                                    <span class="text-muted small">· <%= ROLE_LABELS[m.evaluator_role] || m.evaluator_role %> + <%= ROLE_LABELS[m.evaluator_role_2] || m.evaluator_role_2 %></span>
                                    <% phases.forEach(function(p) { %>
                                        <div class="d-flex justify-content-between align-items-center py-1 small border-top">
                                            <div>
                                                <strong><%= p.title %></strong>
                                                <% if (p.role) { %><span class="text-muted">· <%= ROLE_LABELS[p.role] || p.role %></span><% } %>
                                                <% if (p.ev && p.canView && p.ev.overall_grade != null) { %>
                                                    <span class="badge bg-success"><%= t('thesisDetail.grade') %> <%= Number(p.ev.overall_grade).toFixed(1) %></span>
                                                    <% if (!p.ev.completed) { %><span class="text-muted">(<%= t('thesisDetail.inProgress') %>)</span><% } %>
                                                <% } else if (p.ev) { %>
                                                    <% if (p.canView) { %><span class="badge bg-warning text-dark"><%= t('thesisDetail.inProgress') %></span><% } else { %><span class="text-muted"><%= t('thesisDetail.hiddenUntilFinal') %></span><% } %>
                                                <% } else { %>
                                                    <span class="text-muted"><%= t('thesisDetail.notYetCreated') %></span>
                                                <% } %>
                                            </div>
                                            <div>
                                                <% if (p.owner) { %>
                                                    <button class="btn btn-outline-secondary btn-sm" onclick="openEvaluationForm(<%= m.id %>, '<%= p.kind %>', true)"><i class="bi bi-clipboard-check"></i> <%= t('thesisDetail.fillIn') %></button>
                                                <% } else if (p.canView && p.ev) { %>
                                                    <button class="btn btn-outline-secondary btn-sm" onclick="openEvaluationForm(<%= m.id %>, '<%= p.kind %>', false)"><i class="bi bi-eye"></i> <%= t('thesisDetail.view') %></button>
                                                <% } %>
                                                <% if (p.ev && p.canView) { %>
                                                    <a class="btn btn-outline-danger btn-sm" href="/api/thesis-milestones/<%= m.id %>/evaluation.pdf?kind=<%= p.kind %>" target="_blank" title="<%= t('thesisDetail.asPdfTitle') %>"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else if (m.requires_evaluation && !studentEvalsHidden) { %>
                                <% const single = evalByKind['single']; %>
                                <div class="mt-3 bg-light rounded p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="small">
                                            <i class="bi bi-star"></i> <%= t('thesis.evaluation') %>
                                            <% if (m.evaluation_form_id) { %><span class="badge bg-primary ms-1"><%= t('thesisDetail.form') %></span><% } %>
                                            <span class="text-muted">· <%= ROLE_LABELS[m.evaluator_role] || m.evaluator_role %></span>
                                        </strong>
                                        <span>
                                        <% if (m.evaluation_form_id) { %>
                                            <button class="btn btn-outline-secondary btn-sm" onclick="openEvaluationForm(<%= m.id %>, 'single', <%= canEvaluate ? 'true' : 'false' %>)">
                                                <i class="bi bi-clipboard-check"></i> <%= t('thesis.evaluation') %> <%= canEvaluate ? t('thesisDetail.fillIn') : t('thesisDetail.view') %>
                                            </button>
                                            <% if (single) { %>
                                                <a class="btn btn-outline-danger btn-sm" href="/api/thesis-milestones/<%= m.id %>/evaluation.pdf?kind=single" target="_blank" title="<%= t('thesisDetail.asPdfTitle') %>"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                                            <% } %>
                                        <% } else { %>
                                            <% if (canEvaluate) { %>
                                                <button class="btn btn-outline-secondary btn-sm" data-milestone="<%= JSON.stringify({ id: m.id, label: milestoneLabel(m), evaluation: m.evaluation || "" }) %>" onclick="openEvalModal(JSON.parse(this.dataset.milestone))">
                                                    <i class="bi bi-pencil"></i> <%= m.evaluation ? t('thesisDetail.editEvaluation') : t('thesisDetail.evaluate') %>
                                                </button>
                                            <% } %>
                                            <% if (m.evaluation) { %>
                                                <a class="btn btn-outline-danger btn-sm" href="/api/thesis-milestones/<%= m.id %>/evaluation.pdf" target="_blank" title="<%= t('thesisDetail.asPdfTitle') %>"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                                            <% } %>
                                        <% } %>
                                        </span>
                                    </div>
                                    <% if (m.evaluation_form_id) { %>
                                        <% if (single && single.overall_grade != null) { %>
                                            <div class="mt-2">
                                                <%= t('thesisDetail.overallGrade') %>: <strong><%= Number(single.overall_grade).toFixed(1) %></strong>
                                                <% (single.groups || []).forEach(function(g) { %>
                                                    <% if (g.grade != null) { %>
                                                        <span class="badge bg-secondary ms-1" title="<%= g.name %>"><%= g.name %>: <%= Number(g.grade).toFixed(1) %></span>
                                                    <% } %>
                                                <% }); %>
                                                <br><small class="text-muted">
                                                    <%= single.completed ? t('thesisDetail.completed') : t('thesisDetail.inProgress') %>
                                                    <% if (single.evaluator) { %> · <%= t('thesisDetail.by') %> <%= single.evaluator.name %>, <%= single.evaluator.firstname %><% } %>
                                                    <% if (single.evaluated_at) { %> <%= t('thesisDetail.on') %> <%= fmtDateTime(single.evaluated_at) %><% } %>
                                                </small>
                                            </div>
                                        <% } else { %>
                                            <div class="mt-1"><small class="text-muted"><%= t('thesisDetail.noEvaluationYet') %></small></div>
                                        <% } %>
                                    <% } else { %>
                                        <% if (m.evaluation) { %>
                                            <div class="mt-2" style="white-space: pre-wrap;"><%= m.evaluation %></div>
                                            <small class="text-muted">
                                                <%= m.evaluator ? (t('thesisDetail.by') + ' ' + m.evaluator.name + ', ' + m.evaluator.firstname) : '' %>
                                                <% if (m.evaluated_at) { %> <%= t('thesisDetail.on') %> <%= fmtDateTime(m.evaluated_at) %><% } %>
                                            </small>
                                        <% } else { %>
                                            <div class="mt-1"><small class="text-muted"><%= t('thesisDetail.noEvaluationYet') %></small></div>
                                        <% } %>
                                    <% } %>
                                </div>
                            <% } %>

                            <%- include('../partials/swarm-feedback-list', { m, feedbacks: ((typeof swarmFeedbacksByMilestone !== 'undefined' ? swarmFeedbacksByMilestone : {})[m.id] || []), canRead: (typeof swarmFeedbackCanRead !== 'undefined' ? swarmFeedbackCanRead : false), canWrite: (typeof swarmFeedbackCanWrite !== 'undefined' ? swarmFeedbackCanWrite : false), thesisId: thesis.id, user, fmtDateTime }) %>
                            <!-- Feedbackformular -->
                            <% if (m.feedback_form_enabled && canFeedback) { %>
                                <div class="mt-3 border rounded p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="small"><i class="bi bi-chat-square-text"></i> <%= t('thesisDetail.feedbackForm') %></strong>
                                        <% if (feedbackFinal) { %>
                                            <button class="btn btn-outline-secondary btn-sm" data-milestone="<%= JSON.stringify({ id: m.id, label: milestoneLabel(m) }) %>" onclick="openFeedbackModal(JSON.parse(this.dataset.milestone))">
                                                <i class="bi bi-pencil"></i> <%= t('thesisDetail.editFeedback') %>
                                            </button>
                                        <% } else { %>
                                            <span class="text-muted small"><%= t('thesisDetail.finalEvalRequired') %></span>
                                        <% } %>
                                    </div>
                                    <% if (m.feedback_text) { %>
                                        <div class="mt-1"><small class="text-muted"><i class="bi bi-check"></i> <%= t('thesisDetail.feedbackRecorded') %></small></div>
                                    <% } %>
                                </div>
                            <% } %>

                            <!-- Freigaben -->
                            <% if (approvalSlots.length > 0) { %>
                                <div class="mt-3 border rounded p-2 <%= allApproved ? 'border-success' : '' %>">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="small"><i class="bi bi-unlock"></i> <%= t('thesis.approvals') %></strong>
                                        <% if (allApproved) { %><span class="badge bg-success"><i class="bi bi-check-circle"></i> <%= t('thesis.approvalAllDone') %></span><% } %>
                                    </div>
                                    <% if (!canGrantApprovals) { %>
                                        <div class="alert alert-warning py-1 px-2 small mb-2">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            <%= t('thesisDetail.approvalsRequirementPrefix') %> <%= approvalMissing.join(' · ') %>.
                                        </div>
                                    <% } %>
                                    <% approvalSlots.forEach(function(s) { %>
                                        <% const canApproveSlot = (actsAs(s.role) && !studentReadOnly) || isAdmin; %>
                                        <div class="d-flex justify-content-between align-items-center py-1 small">
                                            <div>
                                                <strong><%= t('thesisDetail.approvalNumber', { n: s.n }) %></strong>
                                                <span class="text-muted">· <%= ROLE_LABELS[s.role] || s.role %></span>
                                                <% if (s.approvedAt) { %>
                                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> <%= t('thesis.approvalGranted') %></span>
                                                    <span class="text-muted">
                                                        <% if (s.approver) { %><%= t('thesisDetail.by') %> <%= s.approver.name %>, <%= s.approver.firstname %><% } %>
                                                        <%= t('thesisDetail.on') %> <%= fmtDateTime(s.approvedAt) %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark"><%= t('thesis.approvalPending') %></span>
                                                <% } %>
                                            </div>
                                            <% if (canApproveSlot) { %>
                                                <div>
                                                    <% if (!s.approvedAt) { %>
                                                        <button class="btn btn-success btn-sm" onclick="setApproval(<%= m.id %>, <%= s.n %>, true)"
                                                                <% if (!canGrantApprovals) { %>disabled title="<%= approvalMissing.join(' · ') %>"<% } %>>
                                                            <i class="bi bi-check-lg"></i> <%= t('thesis.grant') %>
                                                        </button>
                                                    <% } else { %>
                                                        <button class="btn btn-outline-danger btn-sm" onclick="setApproval(<%= m.id %>, <%= s.n %>, false)"><i class="bi bi-x-lg"></i> <%= t('thesis.revoke') %></button>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } %>
                            <% } /* Ende: nicht-minimale Karte */ %>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>

        <!-- Änderungsprotokoll -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> <%= t('thesisDetail.changeLog') %></h5>
            </div>
            <div class="card-body">
                <% if (!logs || logs.length === 0) { %>
                    <p class="text-muted mb-0"><%= t('thesisDetail.noChangesLogged') %></p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th><%= t('thesisDetail.timestamp') %></th>
                                    <th><%= t('thesisDetail.user') %></th>
                                    <th><%= t('thesisDetail.action') %></th>
                                    <th><%= t('thesisDetail.detail') %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% logs.forEach(function(log) { %>
                                    <tr>
                                        <td class="text-nowrap"><small><%= fmtDateTime(log.createdAt) %></small></td>
                                        <td><small><%= log.user ? (log.user.name + ', ' + log.user.firstname) : t('thesisDetail.unknown') %></small></td>
                                        <td><small><%= ACTION_LABELS[log.action] || log.action %></small></td>
                                        <td><small class="text-muted"><%= log.detail || '' %></small></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

