<script>
const L = {
    uploading: <%- JSON.stringify(t('thesisDetail.uploading')) %>,
    errorPrefix: <%- JSON.stringify(t('templatesPage.errorPrefix')) %>,
    unknown: <%- JSON.stringify(t('thesisDetail.unknown')) %>,
    genericError: <%- JSON.stringify(t('templatesPage.genericError')) %>,
    uploadError: <%- JSON.stringify(t('thesisDetail.uploadError')) %>,
    saveEvaluationError: <%- JSON.stringify(t('thesisDetail.saveEvaluationError')) %>,
    confirmReleaseMilestone: <%- JSON.stringify(t('thesisDetail.confirmReleaseMilestone')) %>,
    confirmLockMilestone: <%- JSON.stringify(t('thesisDetail.confirmLockMilestone')) %>,
    approvalError: <%- JSON.stringify(t('thesisDetail.approvalError')) %>,
    confirmGrantApproval: <%- JSON.stringify(t('thesisDetail.confirmGrantApproval')) %>,
    confirmRevokeApproval: <%- JSON.stringify(t('thesisDetail.confirmRevokeApproval')) %>,
    noFormAssigned: <%- JSON.stringify(t('thesisDetail.noFormAssigned')) %>,
    evalHiddenUntilFinal: <%- JSON.stringify(t('thesisDetail.evalHiddenUntilFinal')) %>,
    evalNotStarted: <%- JSON.stringify(t('thesisDetail.evalNotStarted')) %>,
    loadError: <%- JSON.stringify(t('thesisDetail.loadError')) %>,
    evaluation1: <%- JSON.stringify(t('thesisDetail.evaluation1')) %>,
    evaluation2: <%- JSON.stringify(t('thesisDetail.evaluation2')) %>,
    finalEvaluation: <%- JSON.stringify(t('thesisDetail.finalEvaluation')) %>,
    evaluation: <%- JSON.stringify(t('thesis.evaluation')) %>,
    roleLabels: <%- JSON.stringify({ student: t('roles.student'), coach: t('roles.coach'), expert: t('roles.expert'), admin: t('roles.admin'), department_lead: t('roles.department_lead'), field_project_coach: t('roles.field_project_coach') }) %>,
    evaluatorFallback: <%- JSON.stringify(t('thesisDetail.evaluatorFallback')) %>,
    evaluator1: <%- JSON.stringify(t('thesisDetail.evaluator1')) %>,
    evaluator2: <%- JSON.stringify(t('thesisDetail.evaluator2')) %>,
    adopt: <%- JSON.stringify(t('thesisDetail.adopt')) %>,
    noPoints: <%- JSON.stringify(t('thesisDetail.noPoints')) %>,
    comment: <%- JSON.stringify(t('thesisDetail.comment')) %>,
    weight: <%- JSON.stringify(t('thesisDetail.weight')) %>,
    grade: <%- JSON.stringify(t('thesisDetail.grade')) %>,
    level: <%- JSON.stringify(t('thesisDetail.level')) %>,
    weightMaxPoints: <%- JSON.stringify(t('thesisDetail.weightMaxPoints')) %>,
    pointsHint: <%- JSON.stringify(t('thesisDetail.pointsHint')) %>,
    remark: <%- JSON.stringify(t('thesisDetail.remark')) %>,
    remarkPlaceholder: <%- JSON.stringify(t('thesisDetail.remarkPlaceholder')) %>,
    overallGradePreview: <%- JSON.stringify(t('thesisDetail.overallGradePreview')) %>,
    remarkRequiredError: <%- JSON.stringify(t('thesisDetail.remarkRequiredError')) %>,
    saveError: <%- JSON.stringify(t('thesisDetail.saveError')) %>,
    confirmDeleteDocVersion: <%- JSON.stringify(t('thesisDetail.confirmDeleteDocVersion')) %>,
    deleteError: <%- JSON.stringify(t('thesisDetail.deleteError')) %>,
    confirmResetDueAt: <%- JSON.stringify(t('thesisDetail.confirmResetDueAt')) %>,
    resetError: <%- JSON.stringify(t('thesisDetail.resetError')) %>,
    loading: <%- JSON.stringify(t('common.loading')) %>,
    moduleGrade: <%- JSON.stringify(t('thesisDetail.moduleGrade')) %>,
    confidentialNoLlm: <%- JSON.stringify(t('thesisDetail.confidentialNoLlm')) %>,
    confidentialManualFeedback: <%- JSON.stringify(t('thesisDetail.confidentialManualFeedback')) %>,
    finalEvalPrereq: <%- JSON.stringify(t('thesisDetail.finalEvalPrereq')) %>,
    networkError: <%- JSON.stringify(t('thesisDetail.networkError')) %>,
    feedbackTextExists: <%- JSON.stringify(t('thesisDetail.feedbackTextExists')) %>,
    preparing: <%- JSON.stringify(t('thesisDetail.preparing')) %>,
    llmProcessingError: <%- JSON.stringify(t('thesisDetail.llmProcessingError')) %>,
    llmNetworkError: <%- JSON.stringify(t('thesisDetail.llmNetworkError')) %>,
    networkSaveError: <%- JSON.stringify(t('thesisDetail.networkSaveError')) %>,
};

function toLocalInput(iso) {
    const d = new Date(iso);
    const pad = n => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function openUploadModal(id, label, categoryId, categoryLabel) {
    document.getElementById('uploadForm').reset();
    document.getElementById('uploadMilestoneId').value = id;
    document.getElementById('uploadModalLabel').textContent = label;
    const catRow = document.getElementById('uploadCategoryRow');
    const catInput = document.getElementById('uploadCategoryId');
    const catLabel = document.getElementById('uploadCategoryLabel');
    if (categoryId) {
        catInput.value = categoryId;
        catLabel.value = categoryLabel || '';
        catRow.classList.remove('d-none');
    } else {
        catInput.value = '';
        catLabel.value = '';
        catRow.classList.add('d-none');
    }
    new bootstrap.Modal(document.getElementById('uploadModal')).show();
}

document.getElementById('uploadForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const id = document.getElementById('uploadMilestoneId').value;
    const formData = new FormData(this);

    const btn = this.querySelector('button[type="submit"]');
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> ' + L.uploading;

    fetch(`/api/thesis-milestones/${id}/document`, { method: 'POST', body: formData })
        .then(r => r.json())
        .then(d => {
            if (d.success) location.reload();
            else alert(L.errorPrefix + (d.message || L.unknown));
        })
        .catch(err => { console.error(err); alert(L.uploadError); })
        .finally(() => { btn.disabled = false; btn.innerHTML = orig; });
});

function openEvalModal(m) {
    document.getElementById('evalMilestoneId').value = m.id;
    document.getElementById('evalModalLabel').textContent = m.label;
    document.getElementById('evalText').value = m.evaluation || '';
    new bootstrap.Modal(document.getElementById('evalModal')).show();
}

document.getElementById('evalForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const id = document.getElementById('evalMilestoneId').value;
    const evaluation = document.getElementById('evalText').value;

    fetch(`/api/thesis-milestones/${id}/evaluation`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ evaluation })
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) location.reload();
        else alert(L.errorPrefix + (d.message || L.unknown));
    })
    .catch(err => { console.error(err); alert(L.saveEvaluationError); });
});

// ---- Meilenstein-Freigabe (Start) ----
function setMilestoneReleased(tmId, released) {
    const msg = released ? L.confirmReleaseMilestone : L.confirmLockMilestone;
    if (!confirm(msg)) return;
    fetch(`/api/thesis-milestones/${tmId}/release`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ released })
    })
    .then(r => r.json())
    .then(d => { if (d.success) location.reload(); else alert(L.errorPrefix + (d.message || L.unknown)); })
    .catch(e => { console.error(e); alert(L.approvalError); });
}

// ---- Dokument-Freigabe (Sign-off) ----
function setApproval(tmId, slot, approved) {
    const msg = approved ? L.confirmGrantApproval.replace('{{n}}', slot) : L.confirmRevokeApproval.replace('{{n}}', slot);
    if (!confirm(msg)) return;
    fetch(`/api/thesis-milestones/${tmId}/approval`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slot, approved })
    })
    .then(r => r.json())
    .then(d => { if (d.success) location.reload(); else alert(L.errorPrefix + (d.message || L.unknown)); })
    .catch(e => { console.error(e); alert(L.approvalError); });
}

// ---- Strukturiertes Bewertungsformular ----
let evalFormState = { tmId: null, editable: false, evaluation: null };

function escapeHtml(s){ return (s||'').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function roundTenth(x){ return Math.round(x*10)/10; }

function openEvaluationForm(tmId, kind, editable) {
    evalFormState = { tmId, kind: kind || 'single', editable, evaluation: null };
    document.getElementById('evalFormBody').innerHTML = '<p class="text-muted">' + L.loading + '</p>';
    document.getElementById('evalFormOverall').innerHTML = '';
    document.getElementById('evalFormSaveBtn').classList.add('d-none');
    new bootstrap.Modal(document.getElementById('evalFormModal')).show();

    fetch(`/api/thesis-milestones/${tmId}/evaluation-form?kind=${encodeURIComponent(evalFormState.kind)}`)
        .then(r => r.json())
        .then(d => {
            if (!d.success) { document.getElementById('evalFormBody').innerHTML = '<div class="alert alert-danger">'+(d.message||L.genericError)+'</div>'; return; }
            if (!d.hasForm) { document.getElementById('evalFormBody').innerHTML = '<div class="alert alert-info">' + L.noFormAssigned + '</div>'; return; }
            if (d.hidden) { document.getElementById('evalFormBody').innerHTML = '<div class="alert alert-info">' + L.evalHiddenUntilFinal + '</div>'; return; }
            if (!d.started) { document.getElementById('evalFormBody').innerHTML = '<div class="alert alert-info">' + L.evalNotStarted + '</div>'; return; }
            evalFormState.editable = !!d.editable;
            evalFormState.evaluation = d.evaluation;
            evalFormState.peers = d.peers || null;
            document.getElementById('evalFormSaveBtn').classList.toggle('d-none', !evalFormState.editable);
            renderEvaluationForm();
        })
        .catch(e => { console.error(e); document.getElementById('evalFormBody').innerHTML = '<div class="alert alert-danger">' + L.loadError + '</div>'; });
}

function renderEvaluationForm() {
    const ev = evalFormState.evaluation;
    const editable = evalFormState.editable;
    const peers = evalFormState.peers || null;
    const groups = (ev.groups || []).slice().sort((a,b)=>a.position-b.position);
    const phaseLabels = { first: L.evaluation1, second: L.evaluation2, final: L.finalEvaluation };
    const phasePrefix = phaseLabels[evalFormState.kind] ? (phaseLabels[evalFormState.kind] + ' — ') : '';
    document.getElementById('evalFormTitle').textContent = phasePrefix + L.evaluation + ' — ' + ev.form_title;

    const ROLE_LABELS = L.roleLabels;
    function roleLabel(r) { return ROLE_LABELS[r] || r || L.evaluatorFallback; }
    function buildPeerBlock(critId) {
        if (!peers || !peers[critId]) return '';
        const p = peers[critId];
        function row(label, peer) {
            if (!peer) return '';
            const hasScore = peer.score !== null && peer.score !== undefined;
            const hasRemark = peer.remark && String(peer.remark).trim();
            if (!hasScore && !hasRemark) return '';
            const role = peer.role ? ' (' + escapeHtml(roleLabel(peer.role)) + ')' : '';
            const scoreLine = hasScore
                ? `<div class="d-flex align-items-center gap-2 mb-1">
                       <span class="text-muted small">${escapeHtml(label)}${role}:</span>
                       <strong>${peer.score}</strong>
                       ${editable ? `<button type="button" class="btn btn-link btn-sm p-0 peer-take-score" data-target="${critId}" data-score="${peer.score}">${L.adopt}</button>` : ''}
                   </div>`
                : `<div class="text-muted small">${escapeHtml(label)}${role}: ${L.noPoints}</div>`;
            const remarkLine = hasRemark
                ? `<div class="d-flex align-items-start gap-2">
                       <span class="text-muted small flex-shrink-0">${L.comment} ${escapeHtml(label)}:</span>
                       <span class="small">${escapeHtml(peer.remark).replace(/\n/g, '<br>')}</span>
                       ${editable ? `<button type="button" class="btn btn-link btn-sm p-0 ms-auto peer-take-remark flex-shrink-0" data-target="${critId}" data-remark="${escapeHtml(peer.remark)}">${L.adopt}</button>` : ''}
                   </div>`
                : '';
            return `<div class="border rounded p-2 mb-1" style="background-color: var(--surface-2);">${scoreLine}${remarkLine}</div>`;
        }
        const html = row(L.evaluator1, p.first) + row(L.evaluator2, p.second);
        return html ? `<div class="mt-2 mb-2">${html}</div>` : '';
    }

    let html = '';
    groups.forEach(g => {
        const crits = (g.criteria || []).slice().sort((a,b)=>a.position-b.position);
        html += `<div class="card mb-3"><div class="card-header d-flex justify-content-between">
            <strong>${escapeHtml(g.name)}</strong>
            <span><span class="badge bg-secondary">${L.weight} ${g.weight}</span> <span class="badge bg-info text-dark" id="grp-grade-${g.id}">${L.grade} —</span></span>
        </div><div class="card-body">`;
        crits.forEach(c => {
            const levels = c.level_descriptions || [];
            let circles = '';
            for (let i=0;i<=5;i++){
                const tip = (levels[i] && levels[i].trim()) ? levels[i] : (L.level + ' ' + i);
                circles += `<button type="button" class="score-circle ${String(c.score)===String(i)?'active':''}" data-score="${i}"
                    data-bs-toggle="tooltip" data-bs-placement="top" title="${escapeHtml(tip)}" ${editable?'':'disabled'}>${i}</button>`;
            }
            const remarkBlock = editable
                ? `<textarea class="form-control form-control-sm crit-remark" rows="3" placeholder="${L.remarkPlaceholder}">${escapeHtml(c.remark||'')}</textarea>`
                : (c.remark ? `<div class="border rounded p-2 bg-white">${renderMarkdownBlock(c.remark)}</div>` : '<span class="text-muted small">—</span>');
            html += `<div class="mb-3 border-bottom pb-3" data-crit="${c.id}" data-weight="${c.weight}" data-group="${g.id}">
                <div class="fw-semibold">${renderMarkdownBlock(c.label)}</div>
                <span class="text-muted small">${L.weightMaxPoints.replace('{{weight}}', c.weight).replace('{{max}}', (5*Number(c.weight)).toFixed(1))}</span>
                ${buildPeerBlock(c.id)}
                <div class="mt-2">
                    <label class="form-label small mb-1">${L.pointsHint}</label>
                    <div class="score-circles">
                        <input type="hidden" class="crit-score" value="${(c.score===null||c.score===undefined)?'':c.score}">
                        ${circles}
                    </div>
                    <div class="small text-muted mt-1 crit-leveldesc"></div>
                </div>
                <div class="mt-2">
                    <label class="form-label small mb-1">${L.remark} <span class="text-muted">(Markdown)</span></label>
                    ${remarkBlock}
                </div>
            </div>`;
        });
        html += `</div></div>`;
    });
    document.getElementById('evalFormBody').innerHTML = html;

    // Übernehmen-Buttons für Bewerter-Vorschläge
    document.querySelectorAll('#evalFormBody .peer-take-score').forEach(btn => {
        btn.addEventListener('click', () => {
            const critId = btn.dataset.target;
            const score = btn.dataset.score;
            const row = document.querySelector(`#evalFormBody [data-crit="${critId}"]`);
            if (!row) return;
            row.querySelector('.crit-score').value = score;
            row.querySelectorAll('.score-circle').forEach(b =>
                b.classList.toggle('active', String(b.getAttribute('data-score')) === String(score))
            );
            updateLevelDesc(row);
            recomputeGrades();
        });
    });
    document.querySelectorAll('#evalFormBody .peer-take-remark').forEach(btn => {
        btn.addEventListener('click', () => {
            const critId = btn.dataset.target;
            const text = btn.dataset.remark || '';
            const row = document.querySelector(`#evalFormBody [data-crit="${critId}"]`);
            if (!row) return;
            const ta = row.querySelector('.crit-remark');
            if (!ta) return;
            const current = ta.value || '';
            // idempotent: wenn der Quelltext bereits enthalten ist, nichts tun
            if (current.indexOf(text) !== -1) return;
            ta.value = current.trim().length === 0 ? text : (current + '\n\n' + text);
        });
    });

    // Level description display, circle selection, live grade recompute
    document.querySelectorAll('#evalFormBody [data-crit]').forEach(row => {
        updateLevelDesc(row);
        row.querySelectorAll('.score-circle:not(:disabled)').forEach(btn => {
            btn.addEventListener('click', () => {
                row.querySelector('.crit-score').value = btn.getAttribute('data-score');
                row.querySelectorAll('.score-circle').forEach(b => b.classList.toggle('active', b === btn));
                updateLevelDesc(row);
                recomputeGrades();
            });
        });
    });

    // Bootstrap-Tooltips initialisieren
    document.querySelectorAll('#evalFormBody [data-bs-toggle="tooltip"]').forEach(el => {
        try { new bootstrap.Tooltip(el); } catch (e) {}
    });

    recomputeGrades();
}

function updateLevelDesc(row) {
    const crit = findCriterion(row.getAttribute('data-crit'));
    const v = row.querySelector('.crit-score').value;
    const desc = row.querySelector('.crit-leveldesc');
    if (!desc) return;
    desc.textContent = (v === '') ? '' : (L.level + ' ' + v + ': ' + ((crit.level_descriptions||[])[Number(v)] || ''));
}

function findCriterion(critId) {
    for (const g of evalFormState.evaluation.groups) {
        for (const c of g.criteria) { if (String(c.id) === String(critId)) return c; }
    }
    return null;
}

function recomputeGrades() {
    const groups = evalFormState.evaluation.groups || [];
    let weightedSum = 0, weightTotal = 0;
    groups.forEach(g => {
        let achieved = 0, max = 0, scored = 0;
        (g.criteria||[]).forEach(c => {
            const row = document.querySelector(`#evalFormBody [data-crit="${c.id}"]`);
            if (!row) return;
            const val = row.querySelector('.crit-score').value;
            if (val === '') return;
            const w = Number(c.weight)||0;
            achieved += Number(val)*w; max += 5*w; scored++;
        });
        const badge = document.getElementById('grp-grade-'+g.id);
        if (scored === 0 || max === 0) { if (badge) badge.textContent = L.grade + ' —'; return; }
        const grade = roundTenth(achieved/max*5+1);
        if (badge) badge.textContent = L.grade + ' ' + grade.toFixed(1);
        weightedSum += grade*(Number(g.weight)||0); weightTotal += (Number(g.weight)||0);
    });
    const overallEl = document.getElementById('evalFormOverall');
    if (weightTotal > 0) overallEl.innerHTML = '<strong>' + L.overallGradePreview + ' ' + roundTenth(weightedSum/weightTotal).toFixed(1) + '</strong>';
    else overallEl.innerHTML = '';
}

function saveEvaluationForm() {
    const rows = document.querySelectorAll('#evalFormBody [data-crit]');
    const criteria = [];
    let validationError = null;
    rows.forEach(row => {
        const id = Number(row.getAttribute('data-crit'));
        const val = row.querySelector('.crit-score').value;
        const remarkEl = row.querySelector('.crit-remark');
        const remark = remarkEl ? remarkEl.value : '';
        const score = (val === '') ? null : Number(val);
        if (score !== null && score < 3 && remark.trim().length < 10) {
            const crit = findCriterion(id);
            const label = crit ? crit.label.replace(/[#*_`>\-]/g, '').trim() : '';
            validationError = L.remarkRequiredError.replace('{{label}}', label);
        }
        criteria.push({ id, score, remark });
    });
    if (validationError) { alert(validationError); return; }

    const btn = document.getElementById('evalFormSaveBtn');
    btn.disabled = true;
    fetch(`/api/thesis-milestones/${evalFormState.tmId}/evaluation-form`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ criteria, kind: evalFormState.kind })
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) location.reload();
        else { alert(L.errorPrefix + (d.message || L.unknown)); btn.disabled = false; }
    })
    .catch(e => { console.error(e); alert(L.saveError); btn.disabled = false; });
}

