// ---- Archivierung selektierter DAs ----
function toggleSelectAllTheses(el) {
    document.querySelectorAll('.thesis-select').forEach(cb => cb.checked = el.checked);
}

async function archiveSelected() {
    const ids = Array.from(document.querySelectorAll('.thesis-select:checked')).map(cb => parseInt(cb.value, 10)).filter(Number.isInteger);
    if (ids.length === 0) { alert(MGMT_L.archiveSelectAtLeastOne); return; }
    if (!confirm(MGMT_L.archiveConfirm.replace('{{n}}', ids.length))) return;
    try {
        const res = await fetch('/api/theses/archive', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ thesisIds: ids }),
        });
        if (!res.ok) {
            const text = await res.text();
            alert(MGMT_L.archiveFailed + ': ' + (text || res.status));
            return;
        }
        const cd = res.headers.get('Content-Disposition') || '';
        const m = cd.match(/filename="?([^"]+)"?/);
        const filename = m ? m[1] : 'Archiv.zip';
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
    } catch (e) {
        alert(MGMT_L.archiveFailed + ': ' + e.message);
    }
}
