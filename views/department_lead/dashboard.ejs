function generateTheses() {
    const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const btn = document.getElementById('generateThesesBtn');
    const target = document.getElementById('generateThesesResult');
    btn.disabled = true;
    target.innerHTML = `<div class="text-muted"><i class="bi bi-hourglass-split"></i> ${esc(MGMT_L.generateRunning)}</div>`;
    fetch('/api/theses/generate-for-department', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ department_id: document.getElementById('generateThesesDept').value }),
    })
    .then(r => r.json())
    .then(d => {
        if (!d.success) {
            btn.disabled = false;
            target.innerHTML = `<div class="alert alert-danger">${esc(d.message || MGMT_L.generateFailed)}</div>`;
            return;
        }
        let html = `<div class="alert alert-success mb-0"><i class="bi bi-check-circle"></i> `
            + `<strong>${d.created.length}</strong> ${esc(MGMT_L.generateCreatedSuffix)}`
            + ` · ${esc(MGMT_L.generateSkipped.replace('{{n}}', d.skipped.length))}`;
        if (d.created.length) html += `<hr class="my-2"><div class="small">${d.created.map(esc).join(' · ')}</div>`;
        html += '</div>';
        target.innerHTML = html;
        // Dashboard nach kurzer Anzeige neu laden, damit die neuen DAs erscheinen.
        if (d.created.length) setTimeout(() => window.location.reload(), 2500);
        else btn.disabled = false;
    })
    .catch(err => {
        console.error(err);
        btn.disabled = false;
        target.innerHTML = `<div class="alert alert-danger">${esc(MGMT_L.generateNetworkError)}</div>`;
    });
}

