<%- include('../partials/header', { title: `${t('milestonesAdmin.title')} - ThesisBuddy`, user: user }) %>

<%
const ROLE_LABELS = { student: t('roles.student'), coach: t('roles.coach'), expert: t('roles.expert'), admin: t('roles.admin'), department_lead: t('roles.department_lead'), field_project_coach: t('roles.field_project_coach') };
%>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/dashboard"><%= t('nav.dashboard') %></a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= t('milestonesAdmin.title') %></li>
            </ol>
        </nav>
        <h1><%= t('milestonesAdmin.title') %></h1>
    </div>
    <div class="text-muted">
        <i class="bi bi-calendar"></i> <%= t('dashboard.year') %>: <%= selectedYear.year %>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-flag"></i> <%= t('milestonesAdmin.cardTitle', { year: selectedYear.year }) %>
        </h5>
        <button class="btn btn-success" onclick="openAddMilestoneModal()">
            <i class="bi bi-plus"></i> <%= t('milestonesAdmin.add') %>
        </button>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            <%= t('milestonesAdmin.templateInfo', { year: selectedYear.year }) %>
            <%= t('milestonesAdmin.existingCountPrefix') %> <strong><%= thesesCount %></strong> <%= t('milestonesAdmin.existingCountSuffix') %>
        </div>

        <% if (milestones.length === 0) { %>
            <div class="text-center py-4">
                <i class="bi bi-flag text-muted" style="font-size: 48px;"></i>
                <p class="text-muted mt-2"><%= t('milestonesAdmin.empty') %></p>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th><%= t('milestonesAdmin.table.label') %></th>
                            <th><%= t('milestonesAdmin.table.dueDate') %></th>
                            <th><%= t('milestonesAdmin.table.responsibleRole') %></th>
                            <th><%= t('milestonesAdmin.table.config') %></th>
                            <th><%= t('common.actions') %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% milestones.forEach(function(m) { %>
                            <tr>
                                <td>
                                    <strong><%= milestoneLabel(m) %></strong>
                                    <% if (m.label_fr && m.label_fr !== m.label) { %>
                                        <div class="small text-muted">
                                            <%= lang === 'fr' ? m.label : m.label_fr %>
                                        </div>
                                    <% } %>
                                </td>
                                <td>
                                    <i class="bi bi-calendar-event"></i>
                                    <%= new Date(m.due_at).toLocaleDateString('de-CH') %>
                                    <%= new Date(m.due_at).toLocaleTimeString('de-CH', { hour: '2-digit', minute: '2-digit' }) %>
                                </td>
                                <td>
                                    <span class="badge bg-secondary"><%= ROLE_LABELS[m.responsible_role] || m.responsible_role %></span>
                                </td>
                                <td>
                                    <% if (m.allow_upload) { %>
                                        <span class="badge bg-success" title="<%= t('milestonesAdmin.badge.uploadAllowedTitle') %>"><i class="bi bi-upload"></i> <%= t('milestonesAdmin.badge.upload') %></span>
                                    <% } else { %>
                                        <span class="badge bg-light text-muted" title="<%= t('milestonesAdmin.badge.noUploadTitle') %>"><i class="bi bi-upload"></i> <%= t('milestonesAdmin.badge.noUpload') %></span>
                                    <% } %>
                                    <% if (m.allow_update) { %>
                                        <span class="badge bg-info text-dark" title="<%= t('milestonesAdmin.badge.updateAllowedTitle') %>"><i class="bi bi-arrow-repeat"></i> <%= t('milestonesAdmin.badge.update') %></span>
                                    <% } %>
                                    <% if (m.requires_evaluation) { %>
                                        <span class="badge bg-warning text-dark" title="<%= t('milestonesAdmin.badge.evaluationByTitle', { role: ROLE_LABELS[m.evaluator_role] || m.evaluator_role }) %>">
                                            <i class="bi bi-star"></i> <%= t('milestonesAdmin.badge.evaluationLabel', { role: ROLE_LABELS[m.evaluator_role] || m.evaluator_role }) %>
                                        </span>
                                        <% if (m.evaluationForm) { %>
                                            <span class="badge bg-primary" title="<%= t('milestonesAdmin.badge.evaluationFormTitle') %>">
                                                <i class="bi bi-clipboard-check"></i> <%= m.evaluationForm.title_de %>
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-light text-muted"><%= t('milestonesAdmin.badge.freetext') %></span>
                                        <% } %>
                                        <% if (m.double_evaluation) { %>
                                            <span class="badge bg-primary" title="<%= t('milestonesAdmin.badge.doubleEvalTitle', { role1: ROLE_LABELS[m.evaluator_role] || m.evaluator_role, role2: ROLE_LABELS[m.evaluator_role_2] || m.evaluator_role_2 }) %>">
                                                <i class="bi bi-people"></i> <%= t('milestonesAdmin.badge.doubleEvalLabel', { role1: ROLE_LABELS[m.evaluator_role] || m.evaluator_role, role2: ROLE_LABELS[m.evaluator_role_2] || m.evaluator_role_2 }) %>
                                            </span>
                                        <% } %>
                                    <% } %>
                                    <% if (m.requires_approval) { %>
                                        <span class="badge bg-dark" title="<%= t('milestonesAdmin.badge.approval1Title', { role: ROLE_LABELS[m.approver_role] || m.approver_role }) %>">
                                            <i class="bi bi-unlock"></i> <%= t('milestonesAdmin.badge.approval1Label', { role: ROLE_LABELS[m.approver_role] || m.approver_role }) %>
                                        </span>
                                    <% } %>
                                    <% if (m.requires_approval_2) { %>
                                        <span class="badge bg-dark" title="<%= t('milestonesAdmin.badge.approval2Title', { role: ROLE_LABELS[m.approver_role_2] || m.approver_role_2 }) %>">
                                            <i class="bi bi-unlock"></i> <%= t('milestonesAdmin.badge.approval2Label', { role: ROLE_LABELS[m.approver_role_2] || m.approver_role_2 }) %>
                                        </span>
                                    <% } %>
                                    <% if (m.applies_to && m.applies_to !== 'all') { %>
                                        <span class="badge bg-primary" title="<%= t('milestonesAdmin.badge.appliesOnlyTitle', { mode: m.applies_to === 'fulltime' ? t('milestonesAdmin.fulltimeStudies') : t('milestonesAdmin.parttimeStudies') }) %>">
                                            <i class="bi <%= m.applies_to === 'fulltime' ? 'bi-book' : 'bi-briefcase' %>"></i> <%= m.applies_to === 'fulltime' ? t('department.fulltime') : t('department.parttime') %>
                                        </span>
                                    <% } %>
                                    <% if (m.is_transfer_project) { %>
                                        <span class="badge bg-info" title="<%= t('thesis.transferProject') %>">
                                            <i class="bi bi-arrow-left-right"></i> <%= t('thesis.transferProject') %>
                                        </span>
                                    <% } %>
                                    <% if (m.is_assignment) { %>
                                        <span class="badge bg-dark" title="<%= t('milestonesAdmin.badge.assignmentTitle') %>">
                                            <i class="bi bi-file-earmark-text"></i> <%= t('milestonesAdmin.badge.assignment') %>
                                        </span>
                                    <% } %>
                                    <% if (m.feedback_form_enabled) { %>
                                        <span class="badge bg-success" title="<%= t('milestonesAdmin.badge.feedbackFormTitle') %>">
                                            <i class="bi bi-chat-square-text"></i> <%= t('milestonesAdmin.badge.feedbackForm') %>
                                        </span>
                                    <% } %>
                                    <% if (m.swarm_feedback_enabled) { %>
                                        <span class="badge bg-info-subtle text-dark"><%= t('milestonesAdmin.swarmFeedbackEnabled') %></span>
                                    <% } %>
                                    <% (m.uploadCategories || []).forEach(function(uc) { %>
                                        <span class="badge bg-secondary" title="<%= t('milestonesAdmin.badge.uploadCategoryTitle') %>">
                                            <i class="bi bi-tag"></i> <%= categoryLabel(uc) %>
                                        </span>
                                    <% }); %>
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <button class="btn btn-outline-primary btn-sm" data-milestone="<%= JSON.stringify(m) %>" onclick="editMilestone(JSON.parse(this.dataset.milestone))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" data-milestone="<%= JSON.stringify(m) %>" onclick="copyMilestone(JSON.parse(this.dataset.milestone))" title="<%= t('milestonesAdmin.copy') %>">
                                            <i class="bi bi-files"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" onclick="deleteMilestone(<%= m.id %>, '<%= m.label.replace(/'/g, "\\'") %>')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Hinzufügen Modal -->
<div class="modal fade" id="addMilestoneModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('milestonesAdmin.add') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addMilestoneForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.labelDe') %></label>
                        <input type="text" class="form-control" name="label" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.labelFr') %></label>
                        <input type="text" class="form-control" name="label_fr" placeholder="<%= t('milestonesAdmin.form.labelFrPlaceholder') %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.dueAt') %></label>
                        <input type="datetime-local" class="form-control" name="due_at" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.table.responsibleRole') %></label>
                        <select class="form-select" name="responsible_role" required>
                            <option value=""><%= t('milestonesAdmin.selectRole') %></option>
                            <option value="student"><%= t('roles.student') %></option>
                            <option value="coach"><%= t('roles.coach') %></option>
                            <option value="expert"><%= t('roles.expert') %></option>
                            <option value="department_lead"><%= t('roles.department_lead') %></option>
                            <option value="field_project_coach"><%= t('roles.field_project_coach') %></option>
                            <option value="admin"><%= t('roles.admin') %></option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.appliesTo') %></label>
                        <select class="form-select" name="applies_to" id="addAppliesTo">
                            <option value="all" selected><%= t('milestonesAdmin.appliesToAll') %></option>
                            <option value="fulltime"><%= t('milestonesAdmin.onlyFulltime') %></option>
                            <option value="parttime"><%= t('milestonesAdmin.onlyParttime') %></option>
                        </select>
                        <div class="form-text"><%= t('milestonesAdmin.form.appliesToHint') %></div>
                    </div>
                    <hr>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="allow_upload" id="addAllowUpload" checked>
                        <label class="form-check-label" for="addAllowUpload"><%= t('milestonesAdmin.form.allowUpload') %></label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="allow_update" id="addAllowUpdate">
                        <label class="form-check-label" for="addAllowUpdate"><%= t('milestonesAdmin.form.allowUpdate') %></label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="requires_evaluation" id="addRequiresEval" onchange="toggleEvalRole('add')">
                        <label class="form-check-label" for="addRequiresEval"><%= t('milestonesAdmin.form.requiresEvaluation') %></label>
                    </div>
                    <div class="mb-3 d-none" id="addEvalRoleWrap">
                        <label class="form-label"><%= t('milestonesAdmin.form.evaluatorRole') %></label>
                        <select class="form-select" name="evaluator_role" id="addEvalRole">
                            <option value=""><%= t('milestonesAdmin.selectRole') %></option>
                            <option value="coach"><%= t('roles.coach') %></option>
                            <option value="expert"><%= t('roles.expert') %></option>
                            <option value="department_lead"><%= t('roles.department_lead') %></option>
                            <option value="field_project_coach"><%= t('roles.field_project_coach') %></option>
                            <option value="admin"><%= t('roles.admin') %></option>
                        </select>
                    </div>
                    <div class="mb-3 d-none" id="addEvalFormWrap">
                        <label class="form-label"><%= t('milestonesAdmin.form.evaluationForm') %></label>
                        <select class="form-select" name="evaluation_form_id" id="addEvalForm">
                            <option value=""><%= t('milestonesAdmin.freetextOption') %></option>
                        </select>
                    </div>
                    <div class="form-check mb-2 d-none" id="addDoubleEvalWrap">
                        <input type="checkbox" class="form-check-input" name="double_evaluation" id="addDoubleEval" onchange="toggleDoubleEval('add')">
                        <label class="form-check-label" for="addDoubleEval"><%= t('milestonesAdmin.form.doubleEvaluation') %></label>
                    </div>
                    <div class="mb-3 d-none" id="addEvalRole2Wrap">
                        <label class="form-label"><%= t('milestonesAdmin.form.evaluatorRole2') %></label>
                        <select class="form-select" name="evaluator_role_2" id="addEvalRole2">
                            <option value=""><%= t('milestonesAdmin.selectRole') %></option>
                            <option value="coach"><%= t('roles.coach') %></option>
                            <option value="expert"><%= t('roles.expert') %></option>
                            <option value="department_lead"><%= t('roles.department_lead') %></option>
                            <option value="field_project_coach"><%= t('roles.field_project_coach') %></option>
                            <option value="admin"><%= t('roles.admin') %></option>
                        </select>
                        <div class="form-text"><%= t('milestonesAdmin.form.evaluatorRole2Hint') %></div>
                    </div>
                    <hr>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="requires_approval" id="addRequiresApproval" onchange="toggleApprover('add')">
                        <label class="form-check-label" for="addRequiresApproval"><%= t('milestonesAdmin.form.requiresApproval1') %></label>
                    </div>
                    <div class="mb-3 d-none" id="addApproverWrap">
                        <label class="form-label"><%= t('milestonesAdmin.form.approverRole1') %></label>
                        <select class="form-select" name="approver_role" id="addApproverRole">
                            <option value=""><%= t('milestonesAdmin.selectRole') %></option>
                            <option value="student"><%= t('roles.student') %></option>
                            <option value="coach"><%= t('roles.coach') %></option>
                            <option value="expert"><%= t('roles.expert') %></option>
                            <option value="department_lead"><%= t('roles.department_lead') %></option>
                            <option value="field_project_coach"><%= t('roles.field_project_coach') %></option>
                            <option value="admin"><%= t('roles.admin') %></option>
                        </select>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="requires_approval_2" id="addRequiresApproval2" onchange="toggleApprover2('add')">
                        <label class="form-check-label" for="addRequiresApproval2"><%= t('milestonesAdmin.form.requiresApproval2') %></label>
                    </div>
                    <div class="mb-3 d-none" id="addApprover2Wrap">
                        <label class="form-label"><%= t('milestonesAdmin.form.approverRole2') %></label>
                        <select class="form-select" name="approver_role_2" id="addApproverRole2">
                            <option value=""><%= t('milestonesAdmin.selectRole') %></option>
                            <option value="student"><%= t('roles.student') %></option>
                            <option value="coach"><%= t('roles.coach') %></option>
                            <option value="expert"><%= t('roles.expert') %></option>
                            <option value="department_lead"><%= t('roles.department_lead') %></option>
                            <option value="field_project_coach"><%= t('roles.field_project_coach') %></option>
                            <option value="admin"><%= t('roles.admin') %></option>
                        </select>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="is_transfer_project" id="addIsTransferProject">
                        <label class="form-check-label" for="addIsTransferProject"><%= t('thesis.transferProject') %></label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="is_assignment" id="addIsAssignment" onchange="toggleAssignmentUpload('add')">
                        <label class="form-check-label" for="addIsAssignment"><%= t('milestonesAdmin.form.isAssignment') %></label>
                        <div class="form-text"><%= t('milestonesAdmin.form.isAssignmentHint') %></div>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="feedback_form_enabled" id="addFeedbackFormEnabled">
                        <label class="form-check-label" for="addFeedbackFormEnabled"><%= t('milestonesAdmin.form.feedbackFormEnabled') %></label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="swarm_feedback_enabled" id="addSwarmFeedbackEnabled">
                        <label class="form-check-label" for="addSwarmFeedbackEnabled"><%= t('milestonesAdmin.swarmFeedbackEnabled') %></label>
                        <div class="form-text"><%= t('milestonesAdmin.swarmFeedbackEnabledHint') %></div>
                    </div>
                    <div class="mb-3">
                        <label for="addUploadCategories" class="form-label"><%= t('milestonesAdmin.form.uploadCategories') %></label>
                        <select class="form-select" id="addUploadCategories" name="upload_categories" multiple size="4">
                            <% (uploadCategories || []).forEach(function(c) { %>
                                <option value="<%= c.id %>" <%= c.is_active ? '' : 'data-inactive="1"' %>><%= categoryLabel(c) %><%= c.is_active ? '' : t('milestonesAdmin.deactivatedSuffix') %></option>
                            <% }); %>
                        </select>
                        <div class="form-text"><%= t('milestonesAdmin.form.uploadCategoriesHint') %></div>
                    </div>
                    <hr>
                    <h6 class="mb-2"><i class="bi bi-envelope-paper"></i> <%= t('milestonesAdmin.mailReminders') %></h6>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small"><%= t('milestonesAdmin.form.reminderStartAt') %></label>
                            <input type="datetime-local" class="form-control" name="reminder_start_at" id="addReminderStartAt">
                            <div class="form-text"><%= t('milestonesAdmin.form.reminderStartAtHint') %></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><%= t('milestonesAdmin.form.reminderPeriodDays') %></label>
                            <input type="number" class="form-control" name="reminder_period_days" id="addReminderPeriodDays" min="1" step="1" value="7">
                            <div class="form-text"><%= t('milestonesAdmin.form.reminderPeriodDaysHint') %></div>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small"><%= t('milestonesAdmin.form.singleDueAt') %></label>
                            <input type="datetime-local" class="form-control" name="single_due_at" id="addSingleDueAt">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><%= t('milestonesAdmin.form.firstDueAt') %></label>
                            <input type="datetime-local" class="form-control" name="first_due_at" id="addFirstDueAt">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><%= t('milestonesAdmin.form.secondDueAt') %></label>
                            <input type="datetime-local" class="form-control" name="second_due_at" id="addSecondDueAt">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><%= t('milestonesAdmin.form.finalDueAt') %></label>
                            <input type="datetime-local" class="form-control" name="final_due_at" id="addFinalDueAt">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><%= t('milestonesAdmin.form.feedbackDueAt') %></label>
                            <input type="datetime-local" class="form-control" name="feedback_due_at" id="addFeedbackDueAt">
                        </div>
                    </div>
                    <div class="form-text mb-3">
                        <%= t('milestonesAdmin.form.dateHintAdd') %>
                    </div>
                    <hr>
                    <% if (thesesCount > 0) { %>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="applyToExisting" id="addApplyToExisting" checked>
                        <label class="form-check-label" for="addApplyToExisting">
                            <%= t('milestonesAdmin.form.applyToExistingAdd', { count: thesesCount }) %>
                        </label>
                    </div>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                    <button type="submit" class="btn btn-primary"><%= t('milestonesAdmin.submitAdd') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bearbeiten Modal -->
<div class="modal fade" id="editMilestoneModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('milestonesAdmin.edit') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editMilestoneForm">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editMilestoneId">
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.labelDe') %></label>
                        <input type="text" class="form-control" name="label" id="editMilestoneLabel" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.labelFr') %></label>
                        <input type="text" class="form-control" name="label_fr" id="editMilestoneLabelFr" placeholder="<%= t('milestonesAdmin.form.labelFrPlaceholder') %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.dueAt') %></label>
                        <input type="datetime-local" class="form-control" name="due_at" id="editMilestoneDueAt" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.table.responsibleRole') %></label>
                        <select class="form-select" name="responsible_role" id="editMilestoneRole" required>
                            <option value="student"><%= t('roles.student') %></option>
                            <option value="coach"><%= t('roles.coach') %></option>
                            <option value="expert"><%= t('roles.expert') %></option>
                            <option value="department_lead"><%= t('roles.department_lead') %></option>
                            <option value="field_project_coach"><%= t('roles.field_project_coach') %></option>
                            <option value="admin"><%= t('roles.admin') %></option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('milestonesAdmin.form.appliesTo') %></label>
                        <select class="form-select" name="applies_to" id="editAppliesTo">
                            <option value="all"><%= t('milestonesAdmin.appliesToAll') %></option>
                            <option value="fulltime"><%= t('milestonesAdmin.onlyFulltime') %></option>
                            <option value="parttime"><%= t('milestonesAdmin.onlyParttime') %></option>
                        </select>
                        <div class="form-text"><%= t('milestonesAdmin.form.appliesToHintEdit') %></div>
                    </div>
                    <hr>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" name="allow_upload" id="editAllowUpload">
