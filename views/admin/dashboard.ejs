                    </div>
                    <div class="mb-3">
                        <label for="thesisDepartment" class="form-label"><%= t('dashboard.department') %></label>
                        <select class="form-select" id="thesisDepartment" name="department_id" required>
                            <option value=""><%= t('mgmt.thesisForm.departmentSelect') %></option>
                            <% departments.forEach(function(dept) { %>
                                <option value="<%= dept.id %>"><%= dept.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="thesisSponsor" class="form-label"><%= t('mgmt.thesisForm.sponsor') %></label>
                        <input type="text" class="form-control" id="thesisSponsor" name="sponsor">
