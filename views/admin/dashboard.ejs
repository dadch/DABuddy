<%- include('../partials/header', { title: t('dashboard.titleAdmin') + ' - ThesisBuddy', user: user }) %>

<div class="page-header">
    <h1 class="page-title"><%= t('dashboard.titleAdmin') %></h1>
    <div class="page-actions">
        <%- include('../partials/year-switcher', { availableYears: availableYears, selectedYearId: selectedYearId }) %>
        <%- include('../partials/role-switcher', { availableRoles: availableRoles, currentRole: currentRole }) %>
        <div class="dropdown">
            <button class="btn btn-primary btn-icon" type="button" id="dashboardActionsMenu" data-bs-toggle="dropdown" aria-expanded="false" title="<%= t('common.actions') %>">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dashboardActionsMenu">
                <li><button class="dropdown-item" type="button" onclick="openAddThesisModal()"><i class="bi bi-plus"></i> <%= t('dashboard.actions.addThesis') %></button></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/dashboard/admin/years"><i class="bi bi-calendar"></i> <%= t('dashboard.actions.years') %></a></li>
                <li><a class="dropdown-item" href="/dashboard/admin/milestones"><i class="bi bi-flag"></i> <%= t('dashboard.actions.milestones') %></a></li>
                <li><a class="dropdown-item" href="/dashboard/admin/evaluation-forms"><i class="bi bi-clipboard-check"></i> <%= t('dashboard.actions.evaluationForms') %></a></li>
                <li><a class="dropdown-item" href="/dashboard/admin/upload-categories"><i class="bi bi-tag"></i> <%= t('dashboard.actions.uploadCategories') %></a></li>
                <li><a class="dropdown-item" href="/dashboard/document-templates"><i class="bi bi-folder2-open"></i> <%= t('nav.documentTemplates') %></a></li>
                <li><a class="dropdown-item" href="/dashboard/admin/mail"><i class="bi bi-envelope"></i> <%= t('mgmt.mailSettings') %></a></li>
                <li><a class="dropdown-item" href="/dashboard/admin/swarm"><i class="bi bi-people-fill"></i> <%= t('swarm.mode.title') %></a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/api/theses-list.pdf<%= selectedDepartment ? '?department=' + encodeURIComponent(selectedDepartment) : '' %>" target="_blank"><i class="bi bi-file-earmark-pdf"></i> <%= t('dashboard.actions.thesesListPdf') %></a></li>
                <li><a class="dropdown-item" href="/api/theses-list.csv<%= selectedDepartment ? '?department=' + encodeURIComponent(selectedDepartment) : '' %>"><i class="bi bi-file-earmark-spreadsheet"></i> <%= t('dashboard.actions.thesesListCsv') %></a></li>
                <li><a class="dropdown-item" href="/api/transfer-project-overview.pdf" target="_blank"><i class="bi bi-arrow-left-right"></i> <%= t('dashboard.actions.transferOverview') %></a></li>
                <li><button class="dropdown-item" type="button" onclick="openBulkDownloadModal()"><i class="bi bi-archive"></i> <%= t('dashboard.actions.bulkDownload') %></button></li>
                <li><button class="dropdown-item" type="button" onclick="archiveSelected()"><i class="bi bi-box-seam"></i> <%= t('mgmt.archive.menu') %></button></li>
                <li><hr class="dropdown-divider"></li>
                <li><button class="dropdown-item" type="button" onclick="openUserManagementModal()"><i class="bi bi-people"></i> <%= t('dashboard.actions.userManagement') %></button></li>
                <li><button class="dropdown-item" type="button" onclick="openStudentManagement()"><i class="bi bi-mortarboard"></i> <%= t('dashboard.actions.studentManagement') %></button></li>
                <li><button class="dropdown-item" type="button" onclick="openDepartmentManagementModal()"><i class="bi bi-building"></i> <%= t('dashboard.actions.departmentManagement') %></button></li>
            </ul>
        </div>
    </div>
</div>

<div class="stat-card mb-4">
    <div class="stat-label"><i class="bi bi-mortarboard"></i> <%= t('dashboard.totalCount') %></div>
    <div class="stat-value"><%= theses.length %></div>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <form method="GET" action="/dashboard" class="d-flex">
            <select name="department" class="form-select me-2" onchange="this.form.submit()">
                <option value=""><%= t('dashboard.allDepartments') %></option>
                <% departments.forEach(function(dept) { %>
                    <option value="<%= dept.id %>" <%= selectedDepartment == dept.id ? 'selected' : '' %>>
                        <%= dept.name %>
                    </option>
                <% }); %>
            </select>
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-funnel"></i>
            </button>
        </form>
    </div>
</div>

<% if (theses.length === 0) { %>
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i>
        <%= t('dashboard.noTheses') %>
    </div>
<% } else { %>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th style="width: 32px;"><input type="checkbox" class="form-check-input" id="selectAllTheses" onclick="toggleSelectAllTheses(this)"></th>
                    <th><%= t('dashboard.headers.actions') %></th>
                    <th><%= t('dashboard.headers.title') %></th>
                    <th><%= t('dashboard.headers.department') %></th>
                    <th><%= t('dashboard.headers.students') %></th>
                    <th><%= t('dashboard.headers.coaches') %></th>
                    <th><%= t('dashboard.headers.experts') %></th>
                    <th><%= t('dashboard.headers.fieldProjectCoaches') %></th>
                    <th><%= t('dashboard.headers.sponsor') %></th>
                </tr>
            </thead>
            <tbody>
                <% theses.forEach(function(thesis) { %>
                    <tr<% if (thesis.is_locked) { %> class="table-warning"<% } %>>
                        <td><input type="checkbox" class="form-check-input thesis-select" value="<%= thesis.id %>"></td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="/dashboard/thesis/<%= thesis.id %>" class="btn btn-primary btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button class="btn btn-outline-primary btn-sm" onclick="editThesis(<%= thesis.id %>)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" onclick="deleteThesis(<%= thesis.id %>)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                        <td>
                            <% if (thesis.is_locked) { %><i class="bi bi-slash-circle-fill text-danger me-2" title="<%= t('dashboard.thesisLocked') %>"></i><% } %>
                            <strong><%= thesis.title %></strong>
                        </td>
                        <td><%= thesis.department.name %></td>
                        <td>
                            <% if (thesis.students.length > 0) { %>
                                <% thesis.students.forEach(function(student, index) { %>
                                    <span class="badge bg-primary me-1"><%= student.name %>, <%= student.firstname %></span>
                                <% }); %>
                                <% if (thesis.is_repetent) { %>
                                    <span class="badge bg-warning text-dark me-1"><i class="bi bi-arrow-repeat"></i> <%= t('dashboard.repetent') %></span>
                                <% } %>
                            <% } else { %>
                                <span class="text-muted"><%= t('dashboard.noStudents') %></span>
                            <% } %>
                        </td>
                        <td>
                            <% if (thesis.coaches.length > 0) { %>
                                <% thesis.coaches.forEach(function(coach, index) { %>
                                    <span class="badge bg-success me-1"><%= coach.name %>, <%= coach.firstname %></span>
                                <% }); %>
                            <% } else { %>
                                <span class="text-muted"><%= t('dashboard.noCoaches') %></span>
                            <% } %>
                        </td>
                        <td>
                            <% if (thesis.experts.length > 0) { %>
                                <% thesis.experts.forEach(function(expert, index) { %>
                                    <span class="badge bg-info me-1"><%= expert.name %>, <%= expert.firstname %></span>
                                <% }); %>
                            <% } else { %>
                                <span class="text-muted"><%= t('dashboard.noExperts') %></span>
                            <% } %>
                        </td>
                        <td>
                            <% if (thesis.fieldProjectCoaches && thesis.fieldProjectCoaches.length > 0) { %>
                                <% thesis.fieldProjectCoaches.forEach(function(fpc, index) { %>
                                    <span class="badge bg-warning text-dark me-1"><%= fpc.name %>, <%= fpc.firstname %></span>
                                <% }); %>
                            <% } else { %>
                                <span class="text-muted"><%= t('dashboard.noFieldProjectCoaches') %></span>
                            <% } %>
                        </td>
                        <td><%= thesis.sponsor || '-' %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
<% } %>

<!-- Diplomarbeit hinzufügen Modal -->
