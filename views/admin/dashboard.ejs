// CSV-Import Dozierende/Experten (Format siehe Button-Tooltip).
function importUsersCsv(input) {
    const file = input.files && input.files[0];
    if (!file) return;
    const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const target = document.getElementById('userImportResult');
    target.innerHTML = `<div class="text-muted mb-3"><i class="bi bi-hourglass-split"></i> ${esc(MGMT_L.importRunning)}</div>`;
    const fd = new FormData();
    fd.append('file', file);
    fetch('/api/users/import-csv', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(d => {
            input.value = '';
            if (!d.success) {
                target.innerHTML = `<div class="alert alert-danger"><i class="bi bi-x-circle"></i> ${esc(d.message || MGMT_L.importFailed)}</div>`;
                return;
            }
            const cls = d.errors.length ? 'warning' : 'success';
            let html = `<div class="alert alert-${cls} mb-3">`
                + `<i class="bi bi-check-circle"></i> <strong>${d.imported.length}</strong> ${esc(MGMT_L.importImportedSuffix)}`
                + ` · ${esc(MGMT_L.importSkipped.replace('{{n}}', d.skipped.length))}`
                + (d.errors.length ? ` · ${esc(MGMT_L.importInvalid.replace('{{n}}', d.errors.length))}` : '');
            if (d.errors.length) {
                html += `<hr class="my-2"><ul class="mb-0 small">${d.errors.map(e => `<li>${esc(MGMT_L.importLine.replace('{{n}}', e.line))}: ${esc(e.message)}</li>`).join('')}</ul>`;
            }
            html += '</div>';
            target.innerHTML = html;
            loadUsers();
        })
        .catch(err => {
            console.error(err);
            input.value = '';
            target.innerHTML = `<div class="alert alert-danger">${esc(MGMT_L.importNetworkError)}</div>`;
        });
}

