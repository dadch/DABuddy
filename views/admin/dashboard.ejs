                            <tr>
                                <th>${MGMT_L.deptName}</th>
                                <th>${MGMT_L.roles.department_lead}</th>
                                <th>${MGMT_L.deptStudyMode}</th>
                                <th>${MGMT_L.actions}</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${departments.map(dept => `
                                <tr>
                                    <td>${dept.name}</td>
                                    <td>${dept.departmentLead ?
                                        `<span class="badge bg-info">${dept.departmentLead.name}, ${dept.departmentLead.firstname}</span>` :
                                        `<span class="text-muted">${MGMT_L.deptNoLead}</span>`}</td>
                                    <td><span class="badge ${dept.study_mode === 'fulltime' ? 'bg-primary' : 'bg-secondary'}">${STUDY_MODE_LABELS[dept.study_mode] || dept.study_mode}</span></td>
                                    <td>
                                        <button class="btn btn-outline-primary btn-sm" onclick="editDepartment(${dept.id})">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" onclick="deleteDepartment(${dept.id})">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        })
        .catch(error => {
            console.error('Fehler beim Laden der Fachbereiche:', error);
            document.getElementById('departmentsList').innerHTML = `<div class="alert alert-danger">${MGMT_L.deptLoadError}</div>`;
        });
}

function loadDepartmentLeads() {
    fetch('/api/users')
        .then(response => response.json())
        .then(users => {
            const departmentLeads = users.filter(user => user.role === 'department_lead');

            ['departmentLead', 'editDepartmentLead'].forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select) {
                    select.innerHTML = `<option value="">${MGMT_L.deptLeadSelect}</option>`;
                    departmentLeads.forEach(lead => {
                        const option = document.createElement('option');
                        option.value = lead.id;
                        option.textContent = `${lead.name}, ${lead.firstname}`;
                        select.appendChild(option);
                    });
                }
            });
        })
        .catch(error => {
            console.error('Fehler beim Laden der FachbereichsleiterInnen:', error);
        });
}

function loadDepartmentOptions() {
    fetch('/api/departments')
        .then(response => response.json())
        .then(departments => {
            ['userDepartments', 'editUserDepartments'].forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select) {
                    select.innerHTML = '';
                    departments.forEach(dept => {
                        const option = document.createElement('option');
                        option.value = dept.id;
                        option.textContent = dept.name;
                        select.appendChild(option);
                    });
                }
            });
        })
        .catch(error => {
            console.error('Fehler beim Laden der Fachbereichsoptionen:', error);
        });
}

function editDepartment(id) {
    Promise.all([
        fetch(`/api/departments`).then(response => response.json()),
        loadDepartmentLeads()
    ])
    .then(([departments]) => {
        const department = departments.find(d => d.id === id);
        if (!department) {
            alert(MGMT_L.deptNotFound);
            return;
        }

        document.getElementById('editDepartmentId').value = department.id;
        document.getElementById('editDepartmentName').value = department.name;
        document.getElementById('editDepartmentLead').value = department.department_lead_id || '';
        document.getElementById('editDepartmentStudyMode').value = department.study_mode || 'parttime';

        new bootstrap.Modal(document.getElementById('editDepartmentModal')).show();
    })
    .catch(error => {
        console.error('Fehler beim Laden des Fachbereichs:', error);
        alert(MGMT_L.deptLoadDataError);
    });
}

function deleteDepartment(id) {
    if (confirm(MGMT_L.deptDeleteConfirm)) {
        fetch(`/api/departments/${id}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadDepartments();
            } else {
                alert(MGMT_L.deptDeleteError + ': ' + (data.message || MGMT_L.unknownError));
            }
        })
        .catch(error => {
            console.error('Fehler beim Löschen des Fachbereichs:', error);
            alert(MGMT_L.deptDeleteError);
        });
    }
}

document.getElementById('addThesisForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const studentsSelect = document.getElementById('thesisStudents');
    const selectedStudents = Array.from(studentsSelect.selectedOptions).map(option => option.value).filter(value => value !== '');

    if (selectedStudents.length > 2) {
        alert(MGMT_L.thesisMaxStudents);
        return;
    }

    const formData = new FormData(this);
    const data = Object.fromEntries(formData);

    data.students = selectedStudents;
    data.coach = document.getElementById('thesisCoach').value || null;
    data.expert = document.getElementById('thesisExpert').value || null;
    data.field_project_coach = document.getElementById('thesisFieldProjectCoach').value || null;
