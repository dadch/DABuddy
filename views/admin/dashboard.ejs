                        <select class="form-select" id="thesisLanguage" name="language">
                            <option value="de"><%= t('thesis.language_de') %></option>
                            <option value="fr"><%= t('thesis.language_fr') %></option>
                        </select>
                    </div>
                    <div class="mb-3 form-check">
