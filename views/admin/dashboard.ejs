<!-- Benutzerverwaltung Modal -->
<div class="modal fade" id="userManagementModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('mgmt.users.managementTitle') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3 align-items-center">
                    <div class="col-md-6">
                        <button type="button" class="btn btn-success" onclick="openAddUserModal()">
                            <i class="bi bi-person-plus"></i> <%= t('mgmt.users.add') %>
                        </button>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <input type="file" id="userImportFile" accept=".csv,text/csv" class="d-none" onchange="importUsersCsv(this)">
                        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('userImportFile').click()"
                                title="<%= t('mgmt.import.tooltip') %>">
                            <i class="bi bi-upload"></i> <%= t('mgmt.import.button') %>
                        </button>
                        <div class="form-text text-md-end">
                            <%= t('mgmt.import.formatHint') %>
                        </div>
                    </div>
                </div>
                <div id="userImportResult"></div>
                <div class="mb-3">
                    <input type="search" class="form-control" id="userSearchInput"
                           placeholder="<%= t('mgmt.users.searchPlaceholder') %>" oninput="renderUsersList()">
                </div>
                <div id="usersList">
                    <!-- Benutzer werden via AJAX geladen -->
                </div>
            </div>
        </div>
    </div>
</div>

