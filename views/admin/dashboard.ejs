                        <label class="form-check-label" for="thesisIsConfidential">
                            <i class="bi bi-lock"></i> <%= t('mgmt.thesisForm.confidential') %>
                        </label>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="thesisIsRepetent" name="is_repetent">
                        <label class="form-check-label" for="thesisIsRepetent">
                            <i class="bi bi-arrow-repeat"></i> <%= t('dashboard.repetent') %>
                        </label>
                    </div>
                    <div class="mb-3">
                        <label for="thesisStudents" class="form-label"><%= t('mgmt.thesisForm.students') %></label>
                        <select class="form-select" id="thesisStudents" name="students" multiple size="4">
                            <option value=""><%= t('mgmt.thesisForm.studentsSelect') %></option>
                        </select>
                        <div class="form-text"><%= t('mgmt.thesisForm.studentsHint') %></div>
                    </div>
                    <div class="mb-3">
                        <label for="thesisCoach" class="form-label"><%= t('roles.coach') %></label>
                        <select class="form-select" id="thesisCoach" name="coach">
                            <option value=""><%= t('mgmt.thesisForm.coachSelect') %></option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="thesisFieldProjectCoach" class="form-label"><%= t('roles.field_project_coach') %></label>
                        <select class="form-select" id="thesisFieldProjectCoach" name="field_project_coach">
                            <option value=""><%= t('mgmt.thesisForm.fieldProjectCoachSelect') %></option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="thesisExpert" class="form-label"><%= t('roles.expert') %></label>
                        <select class="form-select" id="thesisExpert" name="expert">
                            <option value=""><%= t('mgmt.thesisForm.expertSelect') %></option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                    <button type="submit" class="btn btn-primary"><%= t('dashboard.actions.addThesis') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

