<%- include('../partials/header', { title: t('evalFormsAdmin.pageTitle') + ' - ThesisBuddy', user: user }) %>

<div class="page-breadcrumb mb-2">
    <a href="/dashboard"><%= t('nav.dashboard') %></a>
    <span class="sep"></span>
    <span><%= t('evalFormsAdmin.breadcrumb') %></span>
</div>
<div class="page-header">
    <h1 class="page-title"><%= t('evalFormsAdmin.pageTitle') %></h1>
    <div class="page-actions">
        <button class="btn btn-outline-primary" onclick="document.getElementById('importFile').click()">
            <i class="bi bi-upload"></i> <%= t('evalFormsAdmin.importForm') %>
        </button>
        <input type="file" id="importFile" accept=".tbform,application/json" hidden>
        <button class="btn btn-primary" onclick="openCreateForm()">
            <i class="bi bi-plus"></i> <%= t('evalFormsAdmin.createForm') %>
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            <%= t('evalFormsAdmin.infoBanner') %>
        </div>
        <div id="formsList"><p class="text-muted"><%= t('common.loading') %></p></div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createFormModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('evalFormsAdmin.createModal.title') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label"><%= t('evalFormsAdmin.createModal.titleDe') %></label>
                        <input type="text" class="form-control" name="title_de" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= t('evalFormsAdmin.createModal.titleFr') %></label>
                        <input type="text" class="form-control" name="title_fr" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
                    <button type="submit" class="btn btn-primary"><%= t('evalFormsAdmin.createModal.create') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const L = {
    noForms: <%- JSON.stringify(t('evalFormsAdmin.noForms')) %>,
    loadError: <%- JSON.stringify(t('evalFormsAdmin.loadError')) %>,
    table: {
        titleDe: <%- JSON.stringify(t('evalFormsAdmin.table.titleDe')) %>,
        titleFr: <%- JSON.stringify(t('evalFormsAdmin.table.titleFr')) %>,
        groups: <%- JSON.stringify(t('evalFormsAdmin.table.groups')) %>,
        actions: <%- JSON.stringify(t('evalFormsAdmin.table.actions')) %>
    },
    edit: <%- JSON.stringify(t('evalFormsAdmin.edit')) %>,
    blankPdfDeTitle: <%- JSON.stringify(t('evalFormsAdmin.blankPdfDeTitle')) %>,
    blankPdfDe: <%- JSON.stringify(t('evalFormsAdmin.blankPdfDe')) %>,
    blankPdfFrTitle: <%- JSON.stringify(t('evalFormsAdmin.blankPdfFrTitle')) %>,
    blankPdfFr: <%- JSON.stringify(t('evalFormsAdmin.blankPdfFr')) %>,
    exportTitle: <%- JSON.stringify(t('evalFormsAdmin.exportTitle')) %>,
    export: <%- JSON.stringify(t('evalFormsAdmin.export')) %>,
    errorPrefix: <%- JSON.stringify(t('templatesPage.errorPrefix')) %>,
    unknown: <%- JSON.stringify(t('evalFormsAdmin.errors.unknown')) %>,
    createError: <%- JSON.stringify(t('evalFormsAdmin.errors.create')) %>,
    deleteError: <%- JSON.stringify(t('evalFormsAdmin.errors.delete')) %>,
    importError: <%- JSON.stringify(t('evalFormsAdmin.errors.import')) %>,
    deleteConfirm: <%- JSON.stringify(t('evalFormsAdmin.deleteConfirm')) %>,
    importParseError: <%- JSON.stringify(t('evalFormsAdmin.importParseError')) %>
};

function loadForms() {
    fetch('/api/evaluation-forms')
        .then(r => r.json())
        .then(forms => {
            const el = document.getElementById('formsList');
            if (!forms.length) { el.innerHTML = `<p class="text-muted mb-0">${L.noForms}</p>`; return; }
            el.innerHTML = `
                <div class="table-responsive"><table class="table table-striped">
                    <thead><tr><th>${L.table.titleDe}</th><th>${L.table.titleFr}</th><th>${L.table.groups}</th><th>${L.table.actions}</th></tr></thead>
                    <tbody>
                        ${forms.map(f => `
                            <tr>
                                <td><strong>${escapeHtml(f.title_de)}</strong></td>
                                <td>${escapeHtml(f.title_fr)}</td>
                                <td>${f.groupCount}</td>
                                <td>
                                    <a href="/dashboard/admin/evaluation-forms/${f.id}" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-pencil"></i> ${L.edit}
                                    </a>
                                    <a href="/api/evaluation-forms/${f.id}/blank.pdf" target="_blank" class="btn btn-outline-danger btn-sm" title="${L.blankPdfDeTitle}">
                                        <i class="bi bi-file-earmark-pdf"></i> ${L.blankPdfDe}
                                    </a>
                                    <a href="/api/evaluation-forms/${f.id}/blank.pdf?lang=fr" target="_blank" class="btn btn-outline-danger btn-sm" title="${L.blankPdfFrTitle}">
                                        <i class="bi bi-file-earmark-pdf"></i> ${L.blankPdfFr}
                                    </a>
                                    <a href="/api/evaluation-forms/${f.id}/export" class="btn btn-outline-secondary btn-sm" title="${L.exportTitle}">
                                        <i class="bi bi-download"></i> ${L.export}
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm" onclick="deleteForm(${f.id}, '${escapeHtml(f.title_de).replace(/'/g, "\\'")}')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>`).join('')}
                    </tbody>
                </table></div>`;
        })
        .catch(e => { console.error(e); document.getElementById('formsList').innerHTML = `<div class="alert alert-danger">${L.loadError}</div>`; });
}

function escapeHtml(s) { return (s || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

function openCreateForm() {
    document.getElementById('createForm').reset();
    new bootstrap.Modal(document.getElementById('createFormModal')).show();
}

document.getElementById('createForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(this));
    fetch('/api/evaluation-forms', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
        .then(r => r.json())
        .then(d => {
            if (d.success) window.location.href = '/dashboard/admin/evaluation-forms/' + d.form.id;
            else alert(L.errorPrefix + (d.message || L.unknown));
        })
        .catch(e => { console.error(e); alert(L.createError); });
});

function deleteForm(id, title) {
    if (!confirm(L.deleteConfirm.replace('{{title}}', title))) return;
    fetch('/api/evaluation-forms/' + id, { method: 'DELETE' })
        .then(r => r.json())
        .then(d => { if (d.success) loadForms(); else alert(L.errorPrefix + (d.message || L.unknown)); })
        .catch(e => { console.error(e); alert(L.deleteError); });
}

document.getElementById('importFile').addEventListener('change', function() {
    const file = this.files[0];
    this.value = '';
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
        let data;
        try { data = JSON.parse(reader.result); }
        catch (e) { alert(L.importParseError); return; }
        fetch('/api/evaluation-forms/import', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
            .then(r => r.json())
            .then(d => {
                if (d.success) window.location.href = '/dashboard/admin/evaluation-forms/' + d.form.id;
                else alert(L.errorPrefix + (d.message || L.unknown));
            })
            .catch(e => { console.error(e); alert(L.importError); });
    };
    reader.readAsText(file);
});

loadForms();
</script>

<%- include('../partials/footer') %>
