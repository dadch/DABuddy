<%- include('../partials/header', { title: t('mgmt.mailSettings') + ' - ThesisBuddy', user: user }) %>

<div class="page-breadcrumb mb-2">
    <a href="/dashboard"><%= t('nav.dashboard') %></a>
    <span class="sep"></span>
    <span><%= t('mgmt.mailSettings') %></span>
</div>
<div class="page-header">
    <div>
        <h1 class="page-title"><%= t('mgmt.mailSettings') %></h1>
        <div class="page-subtitle"><%= t('mailAdmin.subtitle') %></div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong><i class="bi bi-server"></i> <%= t('mailAdmin.smtp.title') %></strong>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            <%- t('mailAdmin.smtp.description') %>
        </p>
        <div id="mailConfig" class="mb-3">
            <div class="text-muted"><i class="bi bi-hourglass-split"></i> <%= t('mailAdmin.smtp.loading') %></div>
        </div>
        <button class="btn btn-outline-primary" onclick="testConnection()">
            <i class="bi bi-plug"></i> <%= t('mailAdmin.smtp.testButton') %>
        </button>
        <div id="connectionResult" class="mt-3"></div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong><i class="bi bi-person-vcard"></i> <%= t('mailAdmin.secretariat.title') %></strong>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-2">
            <%= t('mailAdmin.secretariat.description') %>
        </p>
        <div class="d-flex gap-2 align-items-end flex-wrap" style="max-width: 640px;">
            <div class="flex-grow-1">
                <label class="form-label small"><%= t('mailAdmin.secretariat.emailLabel') %></label>
                <input type="email" class="form-control" id="secretariatEmail" placeholder="<%= t('mailAdmin.secretariat.placeholder') %>">
            </div>
            <button type="button" class="btn btn-outline-primary" onclick="saveSecretariatEmail()">
                <i class="bi bi-check-lg"></i> <%= t('common.save') %>
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="clearSecretariatEmail()">
                <i class="bi bi-x-lg"></i> <%= t('mailAdmin.reset') %>
            </button>
        </div>
        <div id="secretariatEmailStatus" class="mt-2 small"></div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong><i class="bi bi-clock-history"></i> <%= t('mailAdmin.reminder.title') %></strong>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-2">
            <%- t('mailAdmin.reminder.description') %>
        </p>
        <button class="btn btn-outline-primary" onclick="runReminders()">
            <i class="bi bi-play-circle"></i> <%= t('mailAdmin.reminder.runButton') %>
        </button>
        <div id="reminderResult" class="mt-3"></div>

        <hr class="my-4">

        <h6 class="mb-2"><i class="bi bi-calendar-event"></i> <%= t('mailAdmin.simDate.title') %></h6>
        <p class="text-muted small mb-2">
            <%= t('mailAdmin.simDate.description') %>
        </p>
        <div class="d-flex gap-2 align-items-end flex-wrap" style="max-width: 640px;">
            <div>
                <label class="form-label small"><%= t('mailAdmin.simDate.label') %></label>
                <input type="date" class="form-control" id="simulatedToday">
            </div>
            <button type="button" class="btn btn-outline-primary" onclick="saveSimulatedToday()">
                <i class="bi bi-check-lg"></i> <%= t('common.save') %>
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="clearSimulatedToday()">
                <i class="bi bi-x-lg"></i> <%= t('mailAdmin.reset') %>
            </button>
        </div>
        <div id="simulatedTodayStatus" class="mt-2 small"></div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong><i class="bi bi-envelope"></i> <%= t('mailAdmin.testMail.title') %></strong>
    </div>
    <div class="card-body">
        <form id="testMailForm">
            <div class="mb-3" style="max-width: 420px;">
                <label class="form-label"><%= t('mailAdmin.testMail.recipientLabel') %></label>
                <input type="email" class="form-control" id="testTo" placeholder="<%= t('mailAdmin.testMail.placeholder') %>" required>
                <div class="form-text">
                    <%- t('mailAdmin.testMail.help') %>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send"></i> <%= t('mailAdmin.testMail.title') %>
            </button>
        </form>
        <div id="sendResult" class="mt-3"></div>
    </div>
</div>

<script>
const L = {
    smtp: {
        host: <%- JSON.stringify(t('mailAdmin.smtp.row.host')) %>,
        port: <%- JSON.stringify(t('mailAdmin.smtp.row.port')) %>,
        secure: <%- JSON.stringify(t('mailAdmin.smtp.row.secure')) %>,
        from: <%- JSON.stringify(t('mailAdmin.smtp.row.from')) %>,
        override: <%- JSON.stringify(t('mailAdmin.smtp.row.override')) %>,
        notSet: <%- JSON.stringify(t('mailAdmin.smtp.row.notSet')) %>,
        overrideActive: <%- JSON.stringify(t('mailAdmin.smtp.row.overrideActive')) %>,
        overrideInactive: <%- JSON.stringify(t('mailAdmin.smtp.row.overrideInactive')) %>,
        checking: <%- JSON.stringify(t('mailAdmin.smtp.checking')) %>,
    },
    yes: <%- JSON.stringify(t('common.yes')) %>,
    no: <%- JSON.stringify(t('common.no')) %>,
    secretariat: {
        active: <%- JSON.stringify(t('mailAdmin.secretariat.status.active')) %>,
        notSet: <%- JSON.stringify(t('mailAdmin.secretariat.status.notSet')) %>,
    },
    simDate: {
        active: <%- JSON.stringify(t('mailAdmin.simDate.status.active')) %>,
        inactive: <%- JSON.stringify(t('mailAdmin.simDate.status.inactive')) %>,
    },
    reminder: {
        running: <%- JSON.stringify(t('mailAdmin.reminder.running')) %>,
        done: <%- JSON.stringify(t('mailAdmin.reminder.done')) %>,
        error: <%- JSON.stringify(t('templatesPage.genericError')) %>,
    },
    testMail: {
        sending: <%- JSON.stringify(t('mailAdmin.testMail.sending')) %>,
        deliveredTo: <%- JSON.stringify(t('mailAdmin.testMail.deliveredTo')) %>,
    },
};

function renderConfig(cfg) {
    const rows = [
        [L.smtp.host, cfg.host || `<span class="text-danger">${L.smtp.notSet}</span>`],
        [L.smtp.port, cfg.port || `<span class="text-danger">${L.smtp.notSet}</span>`],
        [L.smtp.secure, cfg.secure ? L.yes : L.no],
        [L.smtp.from, cfg.from || `<span class="text-danger">${L.smtp.notSet}</span>`],
        [L.smtp.override, cfg.override ? `<span class="badge bg-warning text-dark">${cfg.override}</span> — ${L.smtp.overrideActive}` : `<span class="text-muted">${L.smtp.overrideInactive}</span>`],
    ];
    return `<dl class="row mb-0">${rows.map(([k, v]) => `
        <dt class="col-sm-3 small text-muted">${k}</dt>
        <dd class="col-sm-9 small">${v}</dd>
    `).join('')}</dl>`;
}

async function testConnection() {
    const target = document.getElementById('connectionResult');
    const cfgTarget = document.getElementById('mailConfig');
    target.innerHTML = `<div class="text-muted"><i class="bi bi-hourglass-split"></i> ${L.smtp.checking}</div>`;
    try {
        const r = await fetch('/api/admin/mail/test-connection');
        const d = await r.json();
        if (d.config) cfgTarget.innerHTML = renderConfig(d.config);
        if (d.success) {
            target.innerHTML = `<div class="alert alert-success"><i class="bi bi-check-circle"></i> ${d.message}</div>`;
        } else {
            target.innerHTML = `<div class="alert alert-danger"><i class="bi bi-x-circle"></i> ${d.message}</div>`;
        }
    } catch (e) {
        target.innerHTML = `<div class="alert alert-danger">${e.message}</div>`;
    }
}

document.getElementById('testMailForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const target = document.getElementById('sendResult');
    target.innerHTML = `<div class="text-muted"><i class="bi bi-hourglass-split"></i> ${L.testMail.sending}</div>`;
    const to = document.getElementById('testTo').value.trim();
    try {
        const r = await fetch('/api/admin/mail/send-test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ to }),
        });
        const d = await r.json();
        if (d.success) {
            const delivered = L.testMail.deliveredTo.replace('{{email}}', `<code>${d.effectiveTo}</code>`);
            target.innerHTML = `<div class="alert alert-success"><i class="bi bi-check-circle"></i> ${d.message} — ${delivered}</div>`;
        } else {
            target.innerHTML = `<div class="alert alert-danger"><i class="bi bi-x-circle"></i> ${d.message}</div>`;
        }
    } catch (e) {
        target.innerHTML = `<div class="alert alert-danger">${e.message}</div>`;
    }
});

async function loadSecretariatEmail() {
    const target = document.getElementById('secretariatEmailStatus');
    try {
        const r = await fetch('/api/admin/mail/secretariat-email');
        const d = await r.json();
        document.getElementById('secretariatEmail').value = d.email || '';
        target.innerHTML = d.email
            ? `<span class="badge bg-success"><i class="bi bi-check-circle"></i> ${L.secretariat.active.replace('{{email}}', d.email)}</span>`
            : `<span class="text-muted">${L.secretariat.notSet}</span>`;
    } catch (e) {
        target.innerHTML = `<span class="text-danger">${e.message}</span>`;
    }
}

async function saveSecretariatEmail() {
    const target = document.getElementById('secretariatEmailStatus');
    const email = document.getElementById('secretariatEmail').value.trim();
    try {
        const r = await fetch('/api/admin/mail/secretariat-email', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
        });
        const d = await r.json();
        if (d.success) loadSecretariatEmail();
        else target.innerHTML = `<span class="text-danger">${d.message}</span>`;
    } catch (e) {
        target.innerHTML = `<span class="text-danger">${e.message}</span>`;
    }
}

async function clearSecretariatEmail() {
    document.getElementById('secretariatEmail').value = '';
    await saveSecretariatEmail();
}

async function loadSimulatedToday() {
    const target = document.getElementById('simulatedTodayStatus');
    try {
        const r = await fetch('/api/admin/mail/simulated-today');
        const d = await r.json();
        document.getElementById('simulatedToday').value = d.date || '';
        target.innerHTML = d.date
            ? `<span class="badge bg-warning text-dark"><i class="bi bi-calendar-check"></i> ${L.simDate.active.replace('{{date}}', d.date)}</span>`
            : `<span class="text-muted">${L.simDate.inactive}</span>`;
    } catch (e) {
        target.innerHTML = `<span class="text-danger">${e.message}</span>`;
    }
}

async function saveSimulatedToday() {
    const target = document.getElementById('simulatedTodayStatus');
    const date = document.getElementById('simulatedToday').value.trim();
    try {
        const r = await fetch('/api/admin/mail/simulated-today', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ date }),
        });
        const d = await r.json();
        if (d.success) loadSimulatedToday();
        else target.innerHTML = `<span class="text-danger">${d.message}</span>`;
    } catch (e) {
        target.innerHTML = `<span class="text-danger">${e.message}</span>`;
    }
}

async function clearSimulatedToday() {
    document.getElementById('simulatedToday').value = '';
    await saveSimulatedToday();
}

async function runReminders() {
    const target = document.getElementById('reminderResult');
    target.innerHTML = `<div class="text-muted"><i class="bi bi-hourglass-split"></i> ${L.reminder.running}</div>`;
    try {
        const r = await fetch('/api/admin/mail/run-reminders', { method: 'POST' });
        const d = await r.json();
        if (d.success) {
            const rem = d.reminders || { sent: 0, skipped: 0 };
            const sec = d.secretariat || { checked: 0, sent: 0 };
            const msg = L.reminder.done
                .replace('{{sent}}', rem.sent)
                .replace('{{skipped}}', rem.skipped)
                .replace('{{secSent}}', sec.sent)
                .replace('{{secChecked}}', sec.checked);
            target.innerHTML = `<div class="alert alert-success"><i class="bi bi-check-circle"></i> ${msg}</div>`;
        } else {
            target.innerHTML = `<div class="alert alert-danger">${d.message || L.reminder.error}</div>`;
        }
    } catch (e) {
        target.innerHTML = `<div class="alert alert-danger">${e.message}</div>`;
    }
}

// Initial Konfig laden (auch bei Fehler zeigt die Antwort das Config-Objekt)
testConnection();
loadSimulatedToday();
loadSecretariatEmail();
</script>

<%- include('../partials/footer') %>
