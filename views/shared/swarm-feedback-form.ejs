<%- include('../partials/header', { title: t('swarm.feedback.title') + ' - ThesisBuddy', user: user }) %>
<%#
  Formular Rückmeldung Projektskizze (Schwarmmodus). Wird nur gerendert, wenn der
  Controller Schreibrecht geprüft hat. Vorbelegung ausschliesslich per JS (.value),
  nie als HTML.
%>
<%
const studentNames = (thesis.students || []).map(s => s.firstname + ' ' + s.name).join(', ');
const authorText = user.fullName + ' (' + t('roles.' + user.role) + ')';
// Beim Bearbeiten das Erfassungsdatum zeigen (toJSON() liefert `createdAt`), sonst heute.
const dateSource = existing ? (existing.createdAt || existing.created_at) : null;
const dateText = new Date(dateSource || Date.now()).toLocaleDateString(lang === 'fr' ? 'fr-CH' : 'de-CH');
const backUrl = '/dashboard/thesis/' + thesis.id;
%>

<div class="page-breadcrumb mb-2">
    <a href="/dashboard"><%= t('nav.dashboard') %></a>
    <span class="sep"></span>
    <a href="<%= backUrl %>"><%= thesis.title %></a>
    <span class="sep"></span>
    <span><%= t('swarm.feedback.title') %></span>
</div>
<div class="page-header">
    <div>
        <h1 class="page-title"><%= t('swarm.feedback.title') %></h1>
        <div class="page-subtitle"><%= milestoneLabel(milestone) %></div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3"><%= t('swarm.feedback.student') %></dt>
            <dd class="col-sm-9"><%= studentNames %></dd>
            <dt class="col-sm-3"><%= t('swarm.feedback.author') %></dt>
            <dd class="col-sm-9"><%= authorText %></dd>
            <dt class="col-sm-3"><%= t('swarm.feedback.date') %></dt>
            <dd class="col-sm-9"><%= dateText %></dd>
        </dl>

        <form id="swarmFeedbackForm" novalidate>
            <% [1, 2, 3].forEach(function (n) { %>
            <div class="mb-4">
                <label class="form-label fw-bold" for="criterion_<%= n %>"><%= t('swarm.feedback.criteria.c' + n + '.title') %></label>
                <div class="form-text mb-2"><%= t('swarm.feedback.criteria.c' + n + '.desc') %></div>
                <textarea class="form-control" id="criterion_<%= n %>" name="criterion_<%= n %>" rows="4"></textarea>
            </div>
            <% }); %>

            <fieldset class="mb-4">
                <legend class="form-label fw-bold fs-6"><%= t('swarm.feedback.recommendation.label') %></legend>
                <% ['continue', 'continue_with_conditions', 'stop'].forEach(function (v) { %>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="recommendation" id="rec_<%= v %>" value="<%= v %>">
                    <label class="form-check-label" for="rec_<%= v %>"><%= t('swarm.feedback.recommendation.' + v) %></label>
                </div>
                <% }); %>
                <div class="form-text"><%= t('swarm.feedback.recommendation.hint') %></div>
            </fieldset>

            <div id="conditionBlock" class="mb-4" style="display:none">
                <h2 class="fs-6 fw-bold"><%= t('swarm.feedback.conditionTitle') %></h2>
                <div class="mb-3">
                    <label class="form-label" for="condition_what"><%= t('swarm.feedback.conditionWhat') %></label>
                    <textarea class="form-control" id="condition_what" name="condition_what" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="condition_until"><%= t('swarm.feedback.conditionUntil') %></label>
                    <input type="date" class="form-control" id="condition_until" name="condition_until">
                </div>
            </div>

            <div id="formResult" class="mb-3" aria-live="polite"></div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" id="saveBtn"><%= t('swarm.feedback.save') %></button>
                <a href="<%= backUrl %>" class="btn btn-outline-secondary"><%= t('swarm.feedback.cancel') %></a>
            </div>
        </form>
    </div>
</div>

<script>
const L = {
    'swarm.feedback.validation.recommendationRequired': <%- JSON.stringify(t('swarm.feedback.validation.recommendationRequired')) %>,
    'swarm.feedback.validation.criterionRequired': <%- JSON.stringify(t('swarm.feedback.validation.criterionRequired')) %>,
    'swarm.feedback.validation.invalidDate': <%- JSON.stringify(t('swarm.feedback.validation.invalidDate')) %>,
    networkError: <%- JSON.stringify(t('thesisDetail.networkError')) %>
};
const EXISTING = <%- JSON.stringify(existing).replace(/</g, '\\u003c') %>;
const API_URL = '/api/thesis-milestones/<%= milestone.id %>/swarm-feedbacks/mine';
const BACK_URL = <%- JSON.stringify(backUrl) %>;

(function () {
    const form = document.getElementById('swarmFeedbackForm');
    const block = document.getElementById('conditionBlock');
    const result = document.getElementById('formResult');
    const saveBtn = document.getElementById('saveBtn');
    const radios = form.querySelectorAll('input[name="recommendation"]');

    function selected() {
        const r = form.querySelector('input[name="recommendation"]:checked');
        return r ? r.value : null;
    }
    function toggleCondition() {
        const v = selected();
        block.style.display = (v && v !== 'continue') ? '' : 'none';
    }
    function showError(msg) {
        result.textContent = '';
        const d = document.createElement('div');
        d.className = 'alert alert-danger';
        d.textContent = msg;
        result.appendChild(d);
    }

    if (EXISTING) {
        form.criterion_1.value = EXISTING.criterion_1 || '';
        form.criterion_2.value = EXISTING.criterion_2 || '';
        form.criterion_3.value = EXISTING.criterion_3 || '';
        form.condition_what.value = EXISTING.condition_what || '';
        form.condition_until.value = EXISTING.condition_until || '';
        radios.forEach(function (r) { r.checked = (r.value === EXISTING.recommendation); });
    }
    radios.forEach(function (r) { r.addEventListener('change', toggleCondition); });
    toggleCondition();

    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        result.textContent = '';
        saveBtn.disabled = true;
        const rec = selected();
        const cond = rec && rec !== 'continue';
        const payload = {
            criterion_1: form.criterion_1.value,
            criterion_2: form.criterion_2.value,
            criterion_3: form.criterion_3.value,
            recommendation: rec,
            condition_what: cond ? form.condition_what.value : '',
            condition_until: cond ? form.condition_until.value : ''
        };
        try {
            const resp = await fetch(API_URL, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const d = await resp.json();
            if (d.success) {
                window.location = BACK_URL;
                return;
            }
            showError(L[d.message] || d.message || L.networkError);
        } catch (err) {
            showError(L.networkError);
        }
        saveBtn.disabled = false;
    });
})();
</script>

<%- include('../partials/footer') %>
