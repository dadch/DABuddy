<%- include('../partials/header', { title: t('misc.expertDashboardTitle') + ' - ThesisBuddy', user: user }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= t('dashboard.titleExpert') %></h1>
    <div class="d-flex align-items-center gap-3">
        <span class="text-muted"><i class="bi bi-calendar"></i> <%= t('dashboard.year') %>: <%= yearLabel(selectedYearObj) %></span>
        <%- include('../partials/role-switcher', { availableRoles: availableRoles, currentRole: currentRole }) %>
    </div>
</div>

<% if (theses.length === 0 && swarmTheses.length === 0) { %>
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i>
        <%= t('dashboard.noTheses_role') %>
    </div>
<% } else if (theses.length > 0) { %>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th><%= t('dashboard.headers.title') %></th>
                    <th><%= t('dashboard.headers.department') %></th>
                    <th><%= t('dashboard.headers.students') %></th>
                    <th><%= t('dashboard.headers.coaches') %></th>
                    <th><%= t('dashboard.headers.fieldProjectCoaches') %></th>
                    <th><%= t('dashboard.headers.sponsor') %></th>
                    <th><%= t('dashboard.headers.actions') %></th>
                </tr>
            </thead>
            <tbody>
                <% theses.forEach(function(thesis) { %>
                    <%- include('../partials/thesis-row', { thesis: thesis, swarm: false }) %>
                <% }); %>
            </tbody>
        </table>
    </div>
<% } %>

<% if (swarmTheses.length > 0) { %>
    <h2 class="h4 mt-4"><i class="bi bi-people-fill"></i> <%= t('swarm.dashboard.sectionTitle') %></h2>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th><%= t('dashboard.headers.title') %></th>
                    <th><%= t('dashboard.headers.department') %></th>
                    <th><%= t('dashboard.headers.students') %></th>
                    <th><%= t('dashboard.headers.coaches') %></th>
                    <th><%= t('dashboard.headers.fieldProjectCoaches') %></th>
                    <th><%= t('dashboard.headers.sponsor') %></th>
                    <th><%= t('dashboard.headers.actions') %></th>
                </tr>
            </thead>
            <tbody>
                <% swarmTheses.forEach(function(thesis) { %>
                    <%- include('../partials/thesis-row', { thesis: thesis, swarm: true }) %>
                <% }); %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../partials/footer') %>
